+// Emit `d` on the wasm stack as an f64: F64-repr passes through, I32-repr (an
+// Int32/Boolean/IntPtr Number at runtime) is converted with f64.convert_i32_s --
+// the exact numeric value. Returns false (caller bails the compile) for i64/Value
+// reprs, which would need unboxing. Warp's emitDoubleBinaryArithResult builds
+// MAdd/MSub/MMul/MDiv(lhs, rhs, Double) from NumberOperandIds whose defs can be
+// Int32 phis; emitting f64.* on the raw i32 local is INVALID wasm and V8 rejects
+// the whole module (`f64.add expected f64, found local.get i32`), silently
+// dropping the function to PBL (string-ops / mixed-arith microbenches).
+static bool EmitOperandAsF64(Encoder& e, WJBackend& be, MDefinition* d) {
+  uint8_t r = WJValType(d->type());
+  if (r != uint8_t(TypeCode::F64) && r != uint8_t(TypeCode::I32)) return false;
+  if (!GetOp(e, be, d)) return false;
+  return r == uint8_t(TypeCode::I32) ? e.writeOp(Op::F64ConvertI32S) : true;
+}
