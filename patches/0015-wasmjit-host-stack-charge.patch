+namespace {
+// Charges one PBL activation to gWJJitDepth for its lifetime. Restoring on exit
+// (not subtracting) keeps the counter exact however the activation returns.
+struct WJHostActivation {
+  int32_t saved = 0;
+  bool active = false;
+  explicit WJHostActivation(JSContext* cx) {
+    int32_t charge = js::wasm::WasmJitHostCharge(cx);
+    if (charge) {
+      saved = js::wasm::gWJJitDepth;
+      js::wasm::gWJJitDepth = saved + charge;
+      active = true;
+    }
+  }
+  ~WJHostActivation() {
+    if (active) js::wasm::gWJJitDepth = saved;
+  }
+  bool overCap() const { return active && js::wasm::WasmJitHostOverCap(); }
+};
+}  // namespace
