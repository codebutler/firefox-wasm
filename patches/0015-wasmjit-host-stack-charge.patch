+// HOST-STACK CHARGE. gWJJitDepth only counted emitted wasm-JIT frames, but every
+// PBL->JIT edge also leaves C++ and glue frames on the host (V8) stack: the
+// hostImports + _wjhelp JS shims, wjhelp/wjhelpImpl, a fresh
+// PortableBaselineInterpret activation, ICInterpretOps, ICCallFallback,
+// InternalCallOrConstruct, RunScript, Interpret, MaybeEnterJit. None of them
+// move the linear-memory stack SpiderMonkey's recursion quota watches, so a
+// recursion that alternates JIT and PBL (BotGuard's nested-eval VM on YouTube)
+// overflowed the host stack with gWJJitDepth at only ~50% of the limit -- an
+// uncatchable RangeError that killed the app pthread. Measured on the named
+// diagnostic build: 67 PBL->JIT crossings and 129 PBL activations in a
+// 1357-frame overflow, charged 151584 of a 298080 limit.
+//
+// So every PBL->JIT entry (WasmJitRunCall) and every PBL activation on the
+// JIT's runtime charges a fixed cost to gWJJitDepth for its lifetime (restored
+// on exit, like a JIT frame). Entries refuse -- and latch the suspend watermark
+// -- once the charged depth reaches the limit, so the deep tail stays on PBL's
+// heap stack; a PBL activation that finds too little host stack left
+// (WasmJitHostHeadroomLow) reports a catchable "too much recursion" instead of
+// letting the host stack overflow. Units are the limit's (probe-scaled bytes).
+//
+// The charges decide when the JIT stops entering, not when recursion fails:
+// past the latch the recursion continues in PBL, whose per-level host cost is
+// a quarter of a JIT<->PBL crossing's (measured on the app thread, probe limit
+// 298080: an apply recursion overflows at 114 levels with the JIT on, 469
+// with it off). So the edge charge (GECKO_WJ_HOSTCHARGE, default 12288) latches
+// a mixed recursion early -- about a fifth of the real stack -- and leaves the
+// cheaper PBL tail the rest; BotGuard's recursion on YouTube then completes,
+// as it does with the JIT off. A PBL activation charges GECKO_WJ_PBLCHARGE
+// (default 1792), so the JIT does not start a deep recursion on top of a deep
+// PBL one. GECKO_WJ_HOSTCHARGE=0 turns the charges off (A/B opt-out). They are
+// also off with GECKO_NOWASMJIT and on worker runtimes (the JIT's depth
+// globals belong to the main runtime's thread); the headroom check below is
+// not, since PBL alone can overflow the host stack too.
+int32_t js::wasm::WasmJitHostCharge(JSContext* cx) {
+  static int32_t sCharge = -1;
+  if (sCharge < 0) {
+    if (getenv("GECKO_NOWASMJIT")) {
+      sCharge = 0;
+    } else {
+      const char* s = getenv("GECKO_WJ_HOSTCHARGE");
+      int32_t v = s ? int32_t(atoi(s)) : 12288;
+      sCharge = v > 0 ? v : 0;
+    }
+  }
+  if (!sCharge || !cx || cx->runtime()->parentRuntime) return 0;
+  return sCharge;
+}
+
+int32_t js::wasm::WasmJitEffectiveDepthLimit() {
+  static const char* sEnv = getenv("GECKO_WJ_DEPTHLIMIT");
+  return sEnv ? int32_t(atoi(sEnv)) : gWJJitDepthLimit;
+}
+
+int32_t js::wasm::WasmJitPblCharge(JSContext* cx) {
+  static int32_t sCharge = -1;
+  if (sCharge < 0) {
+    const char* s = getenv("GECKO_WJ_PBLCHARGE");
+    int32_t v = s ? int32_t(atoi(s)) : 1792;
+    sCharge = v > 0 ? v : 0;
+  }
+  return WasmJitHostCharge(cx) ? sCharge : 0;
+}
+
+// The over-recursion check measures the host stack instead of estimating it.
+// A PBL activation's real cost varies several-fold with V8's tier for the
+// interpreter (Liftoff frames are far larger than TurboFan's), so no fixed
+// charge both stops before V8's limit and leaves recursion that fits alone: an
+// apply recursion overflowed at 469 levels in one run and ~250 in another.
+// wasmhost_stack_headroom(n) (wasm-host-bridge.js) recurses a small probe
+// module n levels deep and reports whether V8 let it; only probe frames unwind
+// on the RangeError, inside the host's own try/catch. A probe frame keeps 64
+// f64s loaded from memory live across its call, so it costs ~580 B in every V8
+// tier (a probe whose values could be recomputed shrank 2x+ once TurboFan
+// compiled it, and the JIT-off path overflowed between checks). 256 frames is
+// ~145 KB: room for the next PBL level and for building and unwinding the
+// InternalError. Checked on every PBL activation nested more than 24 deep on a
+// thread; shallow code never pays.
+// GECKO_PBL_HEADROOM=0 disables it, GECKO_PBL_HEADROOMFRAMES=<n> sizes it.
+extern "C" int wasmhost_stack_headroom(int frames);
+
+bool js::wasm::WasmJitHostHeadroomLow() {
+  static int32_t sFrames = -1;
+  if (sFrames < 0) {
+    const char* off = getenv("GECKO_PBL_HEADROOM");
+    const char* n = getenv("GECKO_PBL_HEADROOMFRAMES");
+    sFrames = (off && strcmp(off, "0") == 0) ? 0 : (n ? atoi(n) : 256);
+    if (sFrames < 0) sFrames = 0;
+  }
+  if (!sFrames || wasmhost_stack_headroom(sFrames)) return false;
+  static int susDbg = getenv("GECKO_WJ_SUSDBG") ? 1 : 0;
+  if (susDbg) {
+    static uint64_t n = 0;
+    if (++n <= 20 || (n % 1000) == 0)
+      fprintf(stderr, "[wj-hostcap] #%llu depth=%d frames=%d\n",
+              (unsigned long long)n, gWJJitDepth, sFrames);
+  }
+  return true;
+}
