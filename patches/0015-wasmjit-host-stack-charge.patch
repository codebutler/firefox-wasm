+// GECKO_WJ_FRAMEDBG: before reporting a host-stack over-recursion, walk every
+// JIT activation's frame chain with bounds checks and print the first link
+// that leaves PBL's stack. Diagnostic for the over-recursion error whose stack
+// capture read past linear memory in a deep JIT<->PBL recursion.
+//
+// It follows jsExitFP -> callerFramePtr, which is not how JSJitFrameIter steps
+// (that walks frame types and sizes), so "bad=0" does not prove the chain a
+// stack capture reads is intact.
+static void WJDumpFrameChain(JSContext* cx) {
+  uintptr_t lo = uintptr_t(cx->portableBaselineStack().base);
+  uintptr_t hi = lo + cx->portableBaselineStack().size;
+  int ai = 0, bad = 0;
+  for (js::ActivationIterator it(cx); !it.done() && ai < 400; ++it, ++ai) {
+    js::Activation* act = it.activation();
+    if (!act->isJit()) {
+      fprintf(stderr, "[wj-frames] act#%d %s\n", ai,
+              act->isInterpreter() ? "interp" : "other");
+      continue;
+    }
+    uint8_t* fp = act->asJit()->jsExitFP();
+    uint8_t* ring[4] = {};
+    int rt[4] = {};
+    int n = 0;
+    const char* end = "?";
+    while (true) {
+      if (!fp) { end = "null-exitFP"; break; }
+      if (uintptr_t(fp) < lo || uintptr_t(fp) + sizeof(js::jit::CommonFrameLayout) > hi) {
+        end = "OUT-OF-RANGE"; bad++; break;
+      }
+      auto* f = reinterpret_cast<js::jit::CommonFrameLayout*>(fp);
+      js::jit::FrameType t = f->prevType();
+      ring[n & 3] = fp; rt[n & 3] = int(t);
+      n++;
+      if (js::jit::JSJitFrameIter::isEntry(t)) { end = "entry"; break; }
+      uint8_t* next = f->callerFramePtr();
+      if (next <= fp) { end = "NON-INCREASING"; bad++; fp = next; break; }
+      fp = next;
+      if (n > 200000) { end = "too-long"; break; }
+    }
+    fprintf(stderr, "[wj-frames] act#%d jit exitFP=%p frames=%d end=%s at=%p\n",
+            ai, (void*)act->asJit()->jsExitFP(), n, end, (void*)fp);
+    if (strcmp(end, "entry") != 0) {
+      for (int k = 1; k <= 4 && k <= n; k++) {
+        int idx = (n - k) & 3;
+        fprintf(stderr, "[wj-frames]   -%d fp=%p prevType=%d\n", k,
+                (void*)ring[idx], rt[idx]);
+      }
+    }
+  }
+  fprintf(stderr, "[wj-frames] activations=%d bad=%d pbl=[%p,%p) top=%p\n", ai,
+          bad, (void*)lo, (void*)hi, cx->portableBaselineStack().top);
+}
