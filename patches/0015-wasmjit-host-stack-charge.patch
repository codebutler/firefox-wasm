+namespace {
+// Charges one PBL activation to gWJJitDepth for its lifetime (restoring on exit,
+// not subtracting, keeps the counter exact however the activation returns) and
+// counts this thread's PBL nesting for the host-stack headroom check.
+thread_local int32_t sPBLNest = 0;
+struct WJHostActivation {
+  int32_t saved = 0;
+  bool active = false;
+  explicit WJHostActivation(JSContext* cx) {
+    int32_t charge = js::wasm::WasmJitPblCharge(cx);
+    if (charge) {
+      saved = js::wasm::gWJJitDepth;
+      js::wasm::gWJJitDepth = saved + charge;
+      active = true;
+    }
+    ++sPBLNest;
+  }
+  ~WJHostActivation() {
+    --sPBLNest;
+    if (active) js::wasm::gWJJitDepth = saved;
+  }
+  // Shallow activations never probe: only a thread nested more than 24 PBL
+  // activations deep can be near V8's limit.
+  bool headroomLow() const {
+    return sPBLNest > 24 && js::wasm::WasmJitHostHeadroomLow();
+  }
+};
+}  // namespace
