+// Charges one PBL activation to gWJJitDepth for its lifetime (restoring on exit,
+// not subtracting, keeps the counter exact however the activation returns) and
+// counts this thread's PBL nesting for the host-stack headroom check. Charges
+// apply only where the wasm JIT runs (the main runtime's thread), so nothing
+// else writes the JIT's depth globals.
+thread_local int32_t sPBLNest = 0;
+// The nesting of the last activation whose headroom probe passed (clamped down
+// as activations exit). One passing probe vouches for ~145 KB of host stack,
+// about 30 JIT<->PBL crossings at ~4.4 KB each, so the next probe waits until
+// the nesting is 8 levels deeper.
+thread_local int32_t sLastPassNest = 0;
+struct WJHostActivation {
+  int32_t saved = 0;
+  bool active = false;
+  explicit WJHostActivation(JSContext* cx) {
+    int32_t charge = js::wasm::WasmJitPblCharge(cx);
+    if (charge) {
+      saved = js::wasm::gWJJitDepth;
+      js::wasm::gWJJitDepth = saved + charge;
+      active = true;
+    }
+    ++sPBLNest;
+  }
+  ~WJHostActivation() {
+    --sPBLNest;
+    if (sPBLNest < sLastPassNest) sLastPassNest = sPBLNest;
+    if (active) js::wasm::gWJJitDepth = saved;
+  }
+  // Shallow activations never probe: only a thread nested more than 24 PBL
+  // activations deep can be near V8's limit. The probe also runs only where
+  // the wasm JIT does: it is a JS import measuring the host's central stack,
+  // which a JIT<->PBL recursion fills through the JS shims. With the JIT off
+  // under JSPI, a recursion stays in wasm on the secondary stack, which this
+  // probe cannot see (see patches/README.md, 0015).
+  bool headroomLow() const {
+    if (sPBLNest <= 24 || sPBLNest < sLastPassNest + 8) return false;
+    if (!js::wasm::WasmJitActiveOnThread()) return false;
+    if (js::wasm::WasmJitHostHeadroomLow()) return true;
+    sLastPassNest = sPBLNest;
+    return false;
+  }
+};
