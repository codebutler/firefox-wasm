+// 7). The deep stack is also exactly what an over-recursion error cannot
+// afford to walk. GECKO_WJ_OVERCAPTURE=1 captures one anyway (A/B).
+static void WJReportOverRecursed(JSContext* cx) {
+  static int framedbg = getenv("GECKO_WJ_FRAMEDBG") ? 1 : 0;
+  static int stackless = getenv("GECKO_WJ_OVERCAPTURE") ? 0 : 1;
