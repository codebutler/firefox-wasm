+                          JS::ColumnNumberOneOrigin(), nullptr, msg, cause,
+                          &err)) {
+        JS::Rooted<js::SavedFrame*> noStack(cx);
+        cx->setPendingException(err, noStack);
+        return;
+      }
+    }
+  }
+  js::ReportOverRecursed(cx);
+}
