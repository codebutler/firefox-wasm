+// The host-stack over-recursion is reported as an InternalError with no
+// captured stack (JSContext::onOverRecursedStackless: status OverRecursed as
+// usual; e.stack === "", fileName "", lineNumber 0). The capture walks at most
+// MAX_REPORTED_STACK_DEPTH (128) frames, yet in a browser it read past linear
+// memory in 5 of 10 JIT-on YouTube loads at this point, while the same reports
+// without a capture never crashed (0 of 7, then 0 of 12): a frame link near
+// the top of a deep JIT<->PBL stack is sometimes unwalkable. This avoids one
+// walker of that chain; the root cause is open, and other full walks at that
+// depth (new Error().stack, console.trace, the embedder's caller lookups, GC
+// tracing of JIT activations) may still hit it. GECKO_WJ_OVERCAPTURE=1
+// captures one anyway (A/B).
+static void WJReportOverRecursed(JSContext* cx) {
+  static int framedbg = getenv("GECKO_WJ_FRAMEDBG") ? 1 : 0;
+  static int stackless = getenv("GECKO_WJ_OVERCAPTURE") ? 0 : 1;
+  if (framedbg) {
