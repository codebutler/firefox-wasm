+// HOST-STACK CHARGE. gWJJitDepth only counted emitted wasm-JIT frames, but every
+// PBL->JIT edge also leaves C++ and glue frames on the host (V8) stack: the
+// hostImports + _wjhelp JS shims, wjhelp/wjhelpImpl, a fresh
+// PortableBaselineInterpret activation, ICInterpretOps, ICCallFallback,
+// InternalCallOrConstruct, RunScript, Interpret, MaybeEnterJit. None of them
+// move the linear-memory stack SpiderMonkey's recursion quota watches, so a
+// recursion that alternates JIT and PBL (BotGuard's nested-eval VM on YouTube)
+// overflowed the host stack with gWJJitDepth at only ~50% of the limit -- an
+// uncatchable RangeError that killed the app pthread. Measured on the named
+// diagnostic build: 67 PBL->JIT crossings and 129 PBL activations in a
+// 1357-frame overflow, charged 151584 of a 298080 limit.
+//
+// So every PBL->JIT entry (WasmJitRunCall) and every PBL activation on the
+// JIT's runtime charges a fixed cost to gWJJitDepth for its lifetime (restored
+// on exit, like a JIT frame). Entries refuse -- and latch the suspend watermark
+// -- once the charged depth reaches the limit, so the deep tail stays on PBL's
+// heap stack; a PBL activation past 1.5x the limit (~90% of the calibrated
+// capacity) reports a catchable "too much recursion" instead of letting the
+// host stack overflow. Units are the limit's (probe-scaled bytes).
+// GECKO_WJ_HOSTCHARGE=<n> sets the charge; 0 turns the whole mechanism off
+// (A/B opt-out). Off with GECKO_NOWASMJIT, and off on worker runtimes (the JIT's
+// depth globals belong to the main runtime's thread).
+int32_t js::wasm::WasmJitHostCharge(JSContext* cx) {
+  static int32_t sCharge = -1;
+  if (sCharge < 0) {
+    if (getenv("GECKO_NOWASMJIT")) {
+      sCharge = 0;
+    } else {
+      const char* s = getenv("GECKO_WJ_HOSTCHARGE");
+      int32_t v = s ? int32_t(atoi(s)) : 3072;
+      sCharge = v > 0 ? v : 0;
+    }
+  }
+  if (!sCharge || !cx || cx->runtime()->parentRuntime) return 0;
+  return sCharge;
+}
+
+int32_t js::wasm::WasmJitEffectiveDepthLimit() {
+  static const char* sEnv = getenv("GECKO_WJ_DEPTHLIMIT");
+  return sEnv ? int32_t(atoi(sEnv)) : gWJJitDepthLimit;
+}
+
+bool js::wasm::WasmJitHostOverCap() {
+  int32_t limit = WasmJitEffectiveDepthLimit();
+  if (gWJJitDepth <= limit + limit / 2) return false;
+  static int susDbg = getenv("GECKO_WJ_SUSDBG") ? 1 : 0;
+  if (susDbg) {
+    static uint64_t n = 0;
+    if (++n <= 20 || (n % 1000) == 0)
+      fprintf(stderr, "[wj-hostcap] #%llu depth=%d cap=%d\n",
+              (unsigned long long)n, gWJJitDepth, limit + limit / 2);
+  }
+  return true;
+}
