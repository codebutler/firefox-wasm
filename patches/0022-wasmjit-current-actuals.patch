+// Push actual argument i (boxed i64) as it is NOW, not as it was at entry. The
+// raw wasm param (kWJArg0Param + i) is never spilled or reloaded across a GC, so
+// a minor GC earlier in the body (an allocation's out-of-line path) leaves it
+// holding a moved object's old address. Prefer, in order: the traced arg-root
+// shadow slot (gWJCallRoots[envRootIdx + (usesCallee ? 2 : 1) + i], pushed in
+// the prologue and relocated by WJTraceRoots), present whenever needsArgRoots;
+// the formal's GC-rooted copy local; the raw param only when neither exists,
+// which is before any GC point or in a function with no GC point at all.
+static bool EmitCurrentActual(Encoder& e, WJBackend& be, uint32_t i) {
+  if (be.needsArgRoots && be.useEnvRoot) {
+    uintptr_t rootsBase = uintptr_t(static_cast<void*>(&gWJCallRoots[0]));
+    uint32_t argRootOff = be.usesCallee ? 2 : 1;  // slot offset from envRootIdx
+    return GetLocal(e, be.envRootIdx) && e.writeOp(Op::I32Const) &&
+           e.writeVarS32(int32_t(argRootOff + i)) && e.writeOp(Op::I32Add) &&
+           e.writeOp(Op::I32Const) && e.writeVarS32(8) && e.writeOp(Op::I32Mul) &&
+           e.writeOp(Op::I32Const) && e.writeVarS32(int32_t(rootsBase)) &&
+           e.writeOp(Op::I32Add) && e.writeOp(Op::I64Load) && e.writeVarU32(3) &&
+           e.writeVarU32(0);
+  }
+  uint32_t src = be.argCopyLocal[i] >= 0 ? uint32_t(be.argCopyLocal[i])
+                                         : (kWJArg0Param + i);
+  return GetLocal(e, src);
+}
