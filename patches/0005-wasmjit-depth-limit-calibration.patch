 int32_t gWJJitDepth = 0;
+// Runtime-mutable budget for the recursion byte-guard (EmitDepthCheck loads it
+// per entry). The conservative default bounds any call-containing JIT fn to
+// ~600 frames; the host recalibrates upward to ~60% of the measured wasm stack
+// capacity via wj_set_depth_limit (first wasmhost_instantiate on the thread).
+// GECKO_WJ_DEPTHLIMIT overrides outright (EmitDepthCheck bakes it as a const).
+int32_t gWJJitDepthLimit = 480000;
 }  // namespace wasm
 }  // namespace js
 
+extern "C" EMSCRIPTEN_KEEPALIVE void wj_set_depth_limit(int32_t v) {
+  if (v > 0) js::wasm::gWJJitDepthLimit = v;
+}
