+// DIAG: validate a function activation's environment before
+// InitFunctionEnvironmentObjects uses it (#2197: stale env on a worker).
+static void PBLDiagCheckEnv(JSContext* cx, JSFunction* func, JSObject* env,
+                            bool fromResume) {
+  bool worker = cx->runtime()->parentRuntime != nullptr;
+  if (worker && gPBLDiagPendingResumes.load() > 0) {
+    static std::atomic<uint32_t> n{0};
+    uint32_t k = ++n;
+    if (k <= 20 || k % 1000 == 0)
+      fprintf(stderr, "[pbl-steal] #%u worker activation while another thread's resume hand-off was pending (pre-0028 would have consumed it)\n", unsigned(k));
+  }
+  uintptr_t a = uintptr_t(env);
+  const char* why = nullptr;
+  if (!env) {
+    why = "null";
+  } else if (a >= uintptr_t(emscripten_get_heap_size()) || (a & 7)) {
+    why = "out-of-heap";
+  } else if (!js::gc::IsCellPointerValid(env)) {
+    why = "invalid-cell";
+  } else if (env->compartment() != cx->compartment()) {
+    why = "other-compartment";
+  }
+  if (!why) return;
+  JSScript* sc = func->hasBytecode() ? func->nonLazyScript() : nullptr;
+  fprintf(stderr,
+          "[pbl-envchk] BAD %s worker=%d fromResume=%d env=%p envNursery=%d "
+          "func=%p funcNursery=%d minorGC=%llu majorGC=%llu %s:%u\n",
+          why, int(worker), int(fromResume), (void*)env,
+          int(env && js::gc::IsInsideNursery(env)), (void*)func,
+          int(js::gc::IsInsideNursery(func)),
+          (unsigned long long)cx->runtime()->gc.minorGCCount(),
+          (unsigned long long)cx->runtime()->gc.majorGCCount(),
+          sc && sc->filename() ? sc->filename() : "?",
+          sc ? unsigned(sc->lineno()) : 0);
+}
