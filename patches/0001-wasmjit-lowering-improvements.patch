+    return 0.0;
+  }
+  if (kind == js::wasm::WJH_SETHAS || kind == js::wasm::WJH_SETADD ||
+      kind == js::wasm::WJH_SETDELETE) {
+    // Set.has/add/delete via the same VM helpers Ion's OOL path calls.
+    JS::Rooted<js::SetObject*> set(
+        cx, &JS::Value::fromRawBits(gWJScratch[0]).toObject().as<js::SetObject>());
+    JS::RootedValue key(cx, JS::Value::fromRawBits(gWJScratch[1]));
+    if (kind == js::wasm::WJH_SETADD) {
+      if (!js::jit::SetObjectAdd(cx, set, key)) return 1.0;
