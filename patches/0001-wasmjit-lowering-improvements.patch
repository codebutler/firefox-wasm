+                 .as<js::ClassBodyLexicalEnvironmentObject>());
+    JS::Rooted<js::ClassBodyScope*> scope(cx, &tmpl->scope());
+    js::ClassBodyLexicalEnvironmentObject* env =
+        js::ClassBodyLexicalEnvironmentObject::createWithoutEnclosing(cx, scope);
+    if (!env) return 1.0;
+    gWJScratch[js::wasm::kWJResultSlot] = JS::ObjectValue(*env).asRawBits();
+    return 0.0;
+  }
+  if (kind == js::wasm::WJH_MINMAXARRAY) {
+    // MMinMaxArray: Math.max/min(...arr). Dense array of NUMBERS only -- a
+    // non-number element returns 1.0 so the backend DEOPTS (no side effects yet,
+    // so re-running in PBL is safe). site bit0 = isMax, bit1 = wantInt32.
+    bool isMax = (int(siteF) & 1) != 0;
+    bool wantInt32 = (int(siteF) & 2) != 0;
+    JS::RootedObject obj(cx, &JS::Value::fromRawBits(gWJScratch[0]).toObject());
+    if (!obj->is<js::ArrayObject>()) return 1.0;
+    auto* arr = &obj->as<js::ArrayObject>();
+    if (arr->isIndexed()) return 1.0;
+    uint32_t len = arr->getDenseInitializedLength();
+    double r = isMax ? -mozilla::PositiveInfinity<double>()
+                     : mozilla::PositiveInfinity<double>();
+    for (uint32_t i = 0; i < len; i++) {
+      JS::Value v = arr->getDenseElement(i);
+      if (v.isMagic(JS_ELEMENTS_HOLE)) v = JS::UndefinedValue();
+      if (!v.isNumber()) return 1.0;  // deopt before any side effect
+      double n = v.toNumber();
+      r = isMax ? js::math_max_impl(r, n) : js::math_min_impl(r, n);
+    }
+    if (wantInt32) {
+      int32_t i32;
+      if (!mozilla::NumberIsInt32(r, &i32)) return 1.0;
+      gWJScratch[js::wasm::kWJResultSlot] = JS::Int32Value(i32).asRawBits();
+    } else {
+      gWJScratch[js::wasm::kWJResultSlot] = JS::DoubleValue(r).asRawBits();
+    }
+    return 0.0;
+  }
+  if (kind == js::wasm::WJH_NEWPRIVATENAME) {
+    // MNewPrivateName: a class `#name` private name -> a unique Symbol. The name
+    // atom is staged in scratch[0] from the traced pool.
+    JS::Rooted<JSAtom*> name(
+        cx, &JS::Value::fromRawBits(gWJScratch[0]).toString()->asAtom());
+    JS::Symbol* sym = js::NewPrivateName(cx, name);
+    if (!sym) return 1.0;
+    gWJScratch[js::wasm::kWJResultSlot] = JS::SymbolValue(sym).asRawBits();
+    return 0.0;
+  }
+  if (kind == js::wasm::WJH_FUNCTIONWITHPROTO) {
+    // MFunctionWithProto: a function with an explicit `__proto__`/home-object
+    // proto. scratch[2] holds the baked function.
+    JS::RootedFunction fun(
+        cx, &JS::Value::fromRawBits(gWJScratch[2]).toObject().as<JSFunction>());
+    JS::RootedObject env(cx, &JS::Value::fromRawBits(gWJScratch[0]).toObject());
+    JS::RootedObject proto(cx,
+                           &JS::Value::fromRawBits(gWJScratch[1]).toObject());
+    JSObject* obj = js::FunWithProtoOperation(cx, fun, env, proto);
+    if (!obj) return 1.0;
+    gWJScratch[js::wasm::kWJResultSlot] = JS::ObjectValue(*obj).asRawBits();
+    return 0.0;
+  }
+  if (kind == js::wasm::WJH_INITHOMEOBJECT) {
+    // MInitHomeObject: set the function's [[HomeObject]] (extended slot 0).
+    JS::RootedFunction fun(
+        cx, &JS::Value::fromRawBits(gWJScratch[0]).toObject().as<JSFunction>());
+    JS::RootedValue home(cx, JS::Value::fromRawBits(gWJScratch[1]));
+    fun->setExtendedSlot(FunctionExtended::METHOD_HOMEOBJECT_SLOT, home);
+    gWJScratch[js::wasm::kWJResultSlot] = JS::ObjectValue(*fun).asRawBits();
+    return 0.0;
+  }
+  if (kind == js::wasm::WJH_CHECKCLASSHERITAGE) {
+    // MCheckClassHeritage: heritage must be null or a constructor; anything else
+    // returns 1.0 -> the backend DEOPTS (PBL re-runs and throws).
+    JS::Value h = JS::Value::fromRawBits(gWJScratch[0]);
+    if (h.isNull()) return 0.0;
+    if (!h.isObject()) return 1.0;
+    return js::jit::ObjectIsConstructor(&h.toObject()) ? 0.0 : 1.0;
+  }
+  if (kind == js::wasm::WJH_ISTYPEDARRAYCTOR) {
+    // MIsTypedArrayConstructor: is `obj` a typed array constructor? Pure.
+    JSObject* obj = &JS::Value::fromRawBits(gWJScratch[0]).toObject();
+    gWJScratch[js::wasm::kWJResultSlot] =
+        JS::BooleanValue(js::IsTypedArrayConstructor(obj)).asRawBits();
+    return 0.0;
+  }
+  if (kind == js::wasm::WJH_CHECKFUSE) {
+    // MGuardFuse: is the realm fuse still intact? 0 = intact, 1 = popped ->
+    // the backend DEOPTS to PBL. Pure (no GC). The fuse address is looked up
+    // from the realm at runtime (single-realm shell), so no per-script
+    // dependency registration is needed.
+    auto idx = js::RealmFuses::FuseIndex(int(siteF));
+    js::GuardFuse* fuse = cx->realm()->realmFuses.getFuseByIndex(idx);
+    return (fuse && fuse->intact()) ? 0.0 : 1.0;
+  }
+  if (kind == js::wasm::WJH_SETFUNNAME) {
+    // MSetFunName: inferred function `.name` (const f = () => {}, { m() {} }).
+    JS::RootedFunction fun(
+        cx, &JS::Value::fromRawBits(gWJScratch[0]).toObject().as<JSFunction>());
+    JS::RootedValue name(cx, JS::Value::fromRawBits(gWJScratch[1]));
+    if (!js::SetFunctionName(cx, fun, name,
+                             js::FunctionPrefixKind(int(siteF)))) {
+      return 1.0;
+    }
+    return 0.0;
+  }
+
   return 1.0;
 }
 
