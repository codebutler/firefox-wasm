+    JS::Rooted<js::MapObject*> map(
+        cx, &JS::Value::fromRawBits(gWJScratch[0]).toObject().as<js::MapObject>());
+    JS::RootedValue key(cx, JS::Value::fromRawBits(gWJScratch[1]));
+    if (kind == js::wasm::WJH_MAPGET) {
+      JS::RootedValue rval(cx);
+      if (!js::jit::MapObjectGet(cx, map, key, &rval)) return 1.0;
