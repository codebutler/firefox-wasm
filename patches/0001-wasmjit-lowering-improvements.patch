+    }
+    bool res;
+    if (kind == js::wasm::WJH_SETHAS) {
+      if (!js::jit::SetObjectHas(cx, set, key, &res)) return 1.0;
+    } else {
+      if (!js::jit::SetObjectDelete(cx, set, key, &res)) return 1.0;
+    }
+    gWJScratch[js::wasm::kWJResultSlot] = JS::BooleanValue(res).asRawBits();
+    return 0.0;
+  }
+
   return 1.0;
 }
 
