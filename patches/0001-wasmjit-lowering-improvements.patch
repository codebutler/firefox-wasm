+        cx, &JS::Value::fromRawBits(gWJScratch[2]).toObject().as<JSFunction>());
+    JS::RootedObject env(cx, &JS::Value::fromRawBits(gWJScratch[0]).toObject());
+    JS::RootedObject proto(cx,
+                           &JS::Value::fromRawBits(gWJScratch[1]).toObject());
