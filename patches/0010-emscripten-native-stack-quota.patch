+#elif defined(__EMSCRIPTEN__)
+  // The wasm C stack is emscripten's linear-memory stack, sized at link time
+  // (64MB for this build). The catch-all kDefaultStackQuota (512KB on wasm32)
+  // would cap host-boundary JS recursion at under 1% of the real stack, so
+  // derive the quota from the actual region. GECKO_NATIVE_QUOTAMB overrides.
+  const size_t kUncappedStackQuota = [kDefaultStackQuota] {
+    if (const char* env = getenv("GECKO_NATIVE_QUOTAMB"); env && *env) {
+      return size_t(strtoul(env, nullptr, 10)) * 1024 * 1024;
+    }
+    uintptr_t stackBase = emscripten_stack_get_base();
+    uintptr_t stackEnd = emscripten_stack_get_end();
+    size_t stackSize = stackBase > stackEnd ? size_t(stackBase - stackEnd) : 0;
+    return std::max(stackSize / 2, kDefaultStackQuota);
+  }();
+  const size_t kTrustedScriptBuffer = 1024 * 1024;
 #else
   // Catch-all configuration for other environments.
 #  if defined(DEBUG)
@@ -1379,7 +1398,14 @@ nsresult XPCJSContext::Initialize() {
