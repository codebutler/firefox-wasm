diff --git a/js/src/wasm/WasmJitRuntime.cpp b/js/src/wasm/WasmJitRuntime.cpp
index 1951cbcb07..ea2e17fe9a 100644
--- a/js/src/wasm/WasmJitRuntime.cpp
+++ b/js/src/wasm/WasmJitRuntime.cpp
@@ -5528,6 +5528,17 @@ static double wjhelpImpl(double kindF, double siteF) {
     for (uint32_t i = 0; i < argc; i++) {
       actuals[i] = JS::Value::fromRawBits(gWJScratch[i]);
     }
+    // A mapped arguments object whose formals the CallObject aliases keeps
+    // that CallObject in MAYBE_CALL_SLOT; createForWasmJit takes it from the
+    // staged scope. Anything else there would store ObjectValue(nullptr), which
+    // the next full GC dereferences, so fail loudly here instead (patch 0027).
+    if (callee->needsCallObject() && callee->hasBytecode() &&
+        callee->nonLazyScript()->argsObjAliasesFormals() &&
+        !scopeChain->is<js::CallObject>()) {
+      fprintf(stderr, "[wj-args] staged scope is %s, not the CallObject\n",
+              scopeChain->getClass()->name);
+      MOZ_CRASH("WJH_NEWARGUMENTS: staged scope is not the frame's CallObject");
+    }
     js::ArgumentsObject* obj =
         js::ArgumentsObject::createForWasmJit(cx, callee, scopeChain, actuals, argc);
     if (!obj) return 1.0;
