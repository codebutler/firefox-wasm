+static bool EmitInlineStrEq(Encoder& e, WJBackend& be, MInstruction* ins,
+                            MDefinition* l, MDefinition* r,
+                            MDefinition* missL, MDefinition* missR,
+                            JSOp missOp, bool invert) {
+  auto miss = [&]() -> bool {
+    return EmitStageScratch(e, be, missL, 0) &&
+           EmitStageScratch(e, be, missR, 1) &&
+           EmitHelperCallResult(e, be, ins, WJH_COMPARE, uint32_t(missOp)) &&
+           EmitHelperResultAsType(e, be, MIRType::Boolean);
+  };
