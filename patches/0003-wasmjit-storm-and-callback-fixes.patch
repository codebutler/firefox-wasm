+      !e.writeVarU32(be.propBVKeyLocal) || !unbox(r) ||
+      !e.writeOp(Op::LocalSet) || !e.writeVarU32(be.propTaggedLocal))
+    return false;
+  if (!EmitStrEqCore(e, be, miss)) return false;
+  return !invert || e.writeOp(Op::I32Eqz);
+}
