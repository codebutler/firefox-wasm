diff --git a/js/src/vm/Interpreter.cpp b/js/src/vm/Interpreter.cpp
index d3ec33f213..be59e1e793 100644
--- a/js/src/vm/Interpreter.cpp
+++ b/js/src/vm/Interpreter.cpp
@@ -470,6 +470,71 @@ bool js::RunScript(JSContext* cx, RunState& state) {
     }
   });
 
+#if defined(__EMSCRIPTEN__)
+  // JS->wasm JIT: a hot callee invoked only through this C++ path (native->JS
+  // callbacks: sort comparators, Array/String method callbacks, ...) never
+  // reaches the interpreter/PBL call-site observe hooks, so it would run in
+  // PBL forever. Observe it here and, once lowered, run the wasm entry
+  // directly -- the same dispatch the PBL IC scripted-call path uses.
+  static int sNoNativeObs = getenv("GECKO_WJ_NONATIVEOBS") ? 1 : 0;
+  if (!sNoNativeObs && state.isInvoke() &&
+      !state.asInvoke()->constructing() &&
+      !cx->realm()->debuggerObservesNativeCall()) {
+    const CallArgs& cargs = state.asInvoke()->args();
+    JSObject& calleeObj = cargs.callee();
+    if (calleeObj.is<JSFunction>()) {
+      JSFunction* wjFun = &calleeObj.as<JSFunction>();
+      if (wjFun->isInterpreted() && !wjFun->isClassConstructor()) {
+        static int noDbg = getenv("GECKO_WJ_NOBSDBG") ? 0 : 1;
+        static uint64_t calls = 0, routed = 0;
+        static std::unordered_map<JSScript*, std::pair<uint64_t, std::string>> perFn;
+        bool obs = js::wasm::WasmJitObserveCall(state.script());
+        if (obs) routed++;
+        {
+          auto& slot = perFn[state.script()];
+          slot.first++;
+          if (noDbg && slot.second.empty()) {
+            JSAtom* nm = wjFun->rawAtom();
+            if (nm) {
+              auto ps = js::AtomToPrintableString(cx, nm);
+              if (ps) slot.second = ps.get();
+            }
+          }
+        }
+        if (noDbg && ++calls % 500000 == 0) {
+          fprintf(stderr, "[wj-nobs] calls=%llu routed=%llu\n",
+                  (unsigned long long)calls, (unsigned long long)routed);
+          std::vector<std::pair<JSScript*, uint64_t>> v;
+          for (auto& kv : perFn) v.push_back({kv.first, kv.second.first});
+          std::partial_sort(v.begin(), v.begin() + std::min<size_t>(v.size(), 6),
+                            v.end(),
+                            [](auto& a, auto& b) { return a.second > b.second; });
+          for (size_t i = 0; i < std::min<size_t>(v.size(), 6); i++)
+            fprintf(stderr, "  #%zu %s:%u %s n=%llu\n", i,
+                    v[i].first->filename() ? v[i].first->filename() : "?",
+                    unsigned(v[i].first->lineno()),
+                    perFn[v[i].first].second.c_str(),
+                    (unsigned long long)v[i].second);
+        }
+        if (obs) {
+          uint64_t wbits;
+          js::wasm::gWJCallCallee = ObjectValue(calleeObj).asRawBits();
+          int wjr = js::wasm::WasmJitRunCall(
+              state.script(), cargs.thisv().asRawBits(), cargs.array(),
+              cargs.length(), wjFun->environment(), &wbits);
+          if (wjr == 2) {
+            return false;
+          }
+          if (wjr == 1) {
+            state.setReturnValue(Value::fromRawBits(wbits));
+            return true;
+          }
+        }
+      }
+    }
+  }
+#endif
+
   jit::EnterJitStatus status = jit::MaybeEnterJit(cx, state);
   switch (status) {
     case jit::EnterJitStatus::Error:
diff --git a/js/src/wasm/WasmJitBackend.cpp b/js/src/wasm/WasmJitBackend.cpp
index 821804d796..8ca8e62e88 100644
--- a/js/src/wasm/WasmJitBackend.cpp
+++ b/js/src/wasm/WasmJitBackend.cpp
@@ -4172,6 +4172,971 @@ static bool EmitOperandAsF64(Encoder& e, WJBackend& be, MDefinition* d) {
   return r == uint8_t(TypeCode::I32) ? e.writeOp(Op::F64ConvertI32S) : true;
 }
 
+// Dense-elem + atom-string MegamorphicCache probe for a by-value obj[key]
+// load (MegamorphicLoadSlotByValue, or GetPropertyCache with a dynamic key).
+// Emits the COMPLETE op: every arm ends in the inline load or a staged
+// WJH_GETPROP(site=missSite). Returns false WITHOUT emitting when the
+// receiver/key types don't fit -- the caller then emits its plain fallback.
+static bool EmitByValMegaProbe(Encoder& e, WJBackend& be, MInstruction* ins,
+                               MDefinition* objDef, MDefinition* keyDef,
+                               uint32_t missSite) {
+  static int dbgGate = WJGETENV("GECKO_WJ_MEGAGATEDBG") ? 1 : 0;
+  MIRType objTy = objDef->type();
+  if (objTy != MIRType::Object && objTy != MIRType::Value) {
+    if (dbgGate)
+      fprintf(stderr, "[megaprobe] reject obj type=%d\n", int(objTy));
+    return false;
+  }
+  MIRType keyTy = keyDef->type();
+  if (keyTy != MIRType::Value && keyTy != MIRType::Int32) {
+    if (dbgGate)
+      fprintf(stderr, "[megaprobe] reject key type=%d\n", int(keyTy));
+    return false;
+  }
+  JSContext* mbvCx = js::TlsContext.get();
+  if (!mbvCx) return false;
+  auto mbvMiss = [&]() -> bool {
+    return EmitStageScratch(e, be, objDef, 0) &&
+           EmitStageScratch(e, be, keyDef, 1) &&
+           EmitHelperCallResult(e, be, ins, WJH_GETPROP, missSite);
+  };
+  using MC = js::MegamorphicCache;
+  using ME = js::MegamorphicCacheEntry;
+  uintptr_t cacheAddr =
+      uintptr_t(&mbvCx->runtime()->caches().megamorphicCache);
+  const uint32_t flagsOff = uint32_t(JSString::offsetOfFlags());
+  const int32_t ATOMB = int32_t(js::StringFlags::ATOM_BIT);
+  const int32_t FATM = int32_t(js::StringFlags::FAT_INLINE_MASK);
+  const uint32_t fatHashOff = uint32_t(js::FatInlineAtom::offsetOfHash());
+  const uint32_t normHashOff = uint32_t(js::NormalAtom::offsetOfHash());
+  const uint32_t shapeOff = uint32_t(offsetof(JS::shadow::Object, shape));
+  const uint32_t slotsOff = uint32_t(js::NativeObject::offsetOfSlots());
+  const uint8_t I64T = uint8_t(TypeCode::I64);
+  static int megaProf = WJGETENV("GECKO_WJ_MEGAPROF") ? 1 : 0;
+  auto bump = [&](int i) -> bool {
+    if (!megaProf) return true;
+    uintptr_t a = uintptr_t(&gWJMegaProbe[i]);
+    return e.writeOp(Op::I32Const) && e.writeVarS32(int32_t(a)) &&
+           e.writeOp(Op::I32Const) && e.writeVarS32(int32_t(a)) &&
+           e.writeOp(Op::I32Load) && e.writeVarU32(2) && e.writeVarU32(0) &&
+           e.writeOp(Op::I32Const) && e.writeVarS32(1) &&
+           e.writeOp(Op::I32Add) && e.writeOp(Op::I32Store) &&
+           e.writeVarU32(2) && e.writeVarU32(0);
+  };
+  // For a Value-typed receiver, guard tag==OBJECT and unbox the payload ptr;
+  // non-objects take the miss arm (generic op handles primitives' proto
+  // lookups). The outer if wraps every arm below and closes at the end.
+  bool wrapObjIf = (objTy == MIRType::Value);
+  if (wrapObjIf) {
+    if (!GetOp(e, be, objDef) || !e.writeOp(Op::I64Const) ||
+        !e.writeVarS64(32) || !e.writeOp(Op::I64ShrU) ||
+        !e.writeOp(Op::I32WrapI64) || !e.writeOp(Op::I32Const) ||
+        !e.writeVarS32(int32_t(uint32_t(JSVAL_TAG_OBJECT))) ||
+        !e.writeOp(Op::I32Eq))
+      return false;
+    if (!e.writeOp(Op::If) || !e.writeFixedU8(I64T)) return false;
+    if (!GetOp(e, be, objDef) || !e.writeOp(Op::I32WrapI64)) return false;
+  } else if (!GetOp(e, be, objDef)) {
+    return false;
+  }
+  // obj -> propObjLocal ; shape -> propShapeLocal
+  if (!e.writeOp(Op::LocalSet) ||
+      !e.writeVarU32(be.propObjLocal) || !GetLocal(e, be.propObjLocal) ||
+      !e.writeOp(Op::I32Load) || !e.writeVarU32(2) ||
+      !e.writeVarU32(shapeOff) ||
+      !e.writeOp(Op::LocalSet) || !e.writeVarU32(be.propShapeLocal))
+    return false;
+  // DENSE-ELEM arm: obj[intKey] on Array|Plain with an in-bounds non-hole
+  // slot -> inline element load (the common `arr[i]` at megamorphic
+  // sites; lodash GETPROP ~4.9M/run was dominated by these). Same class
+  // gate as the GetElem CacheIR; OOB/hole/non-dense fall to the string
+  // probe or the generic helper.
+  static int noDense = WJGETENV("GECKO_WJ_NODENSEELEM") ? 1 : 0;
+  bool wrapDense = !noDense;
+  bool wrappedValueKey = false;
+  {
+    if (wrapDense) {
+      {
+        wrappedValueKey = keyTy == MIRType::Value;
+        const uint32_t baseOff = uint32_t(js::Shape::offsetOfBaseShape());
+        const uint32_t claspOff = uint32_t(js::BaseShape::offsetOfClasp());
+        const uint32_t arrCls =
+            uint32_t(uintptr_t(&js::ArrayObject::class_));
+        const uint32_t plainCls =
+            uint32_t(uintptr_t(&js::PlainObject::class_));
+        const uint32_t elemsOff =
+            uint32_t(js::NativeObject::offsetOfElements());
+        const int32_t offIL =
+            js::ObjectElements::offsetOfInitializedLength();
+        const int64_t holeBits =
+            int64_t(JS::MagicValue(JS_ELEMENTS_HOLE).asRawBits());
+        // cond: int-typed key (payload low32 for Value keys)
+        if (keyTy == MIRType::Value) {
+          if (!GetOp(e, be, keyDef) || !e.writeOp(Op::I64Const) ||
+              !e.writeVarS64(32) || !e.writeOp(Op::I64ShrU) ||
+              !e.writeOp(Op::I32WrapI64) || !e.writeOp(Op::I32Const) ||
+              !e.writeVarS32(int32_t(uint32_t(JSVAL_TAG_INT32))) ||
+              !e.writeOp(Op::I32Eq))
+            return false;
+        } else if (!e.writeOp(Op::I32Const) || !e.writeVarS32(1)) {
+          return false;
+        }
+        if (!e.writeOp(Op::If) || !e.writeFixedU8(I64T)) return false;
+        // idx -> propTaggedLocal
+        if (!GetOp(e, be, keyDef)) return false;
+        if (keyTy == MIRType::Value && !e.writeOp(Op::I32WrapI64))
+          return false;
+        if (!e.writeOp(Op::LocalSet) || !e.writeVarU32(be.propTaggedLocal))
+          return false;
+        // clasp in {Array, Plain} ?
+        if (!GetLocal(e, be.propShapeLocal) || !e.writeOp(Op::I32Load) ||
+            !e.writeVarU32(2) || !e.writeVarU32(baseOff) ||
+            !e.writeOp(Op::I32Load) || !e.writeVarU32(2) ||
+            !e.writeVarU32(claspOff) || !e.writeOp(Op::LocalTee) ||
+            !e.writeVarU32(be.propBVKeyLocal) ||
+            !e.writeOp(Op::I32Const) || !e.writeVarS32(int32_t(arrCls)) ||
+            !e.writeOp(Op::I32Eq) || !GetLocal(e, be.propBVKeyLocal) ||
+            !e.writeOp(Op::I32Const) ||
+            !e.writeVarS32(int32_t(plainCls)) || !e.writeOp(Op::I32Eq) ||
+            !e.writeOp(Op::I32Or))
+          return false;
+        if (!e.writeOp(Op::If) || !e.writeFixedU8(I64T)) return false;
+        // elems -> propBVKeyLocal; idx <u elems->initLen ?
+        if (!GetLocal(e, be.propObjLocal) || !e.writeOp(Op::I32Load) ||
+            !e.writeVarU32(2) || !e.writeVarU32(elemsOff) ||
+            !e.writeOp(Op::LocalSet) ||
+            !e.writeVarU32(be.propBVKeyLocal) ||
+            !GetLocal(e, be.propTaggedLocal) ||
+            !GetLocal(e, be.propBVKeyLocal) ||
+            !e.writeOp(Op::I32Const) || !e.writeVarS32(offIL) ||
+            !e.writeOp(Op::I32Add) || !e.writeOp(Op::I32Load) ||
+            !e.writeVarU32(2) || !e.writeVarU32(0) ||
+            !e.writeOp(Op::I32LtU))
+          return false;
+        if (!e.writeOp(Op::If) || !e.writeFixedU8(I64T)) return false;
+        // v = elems[idx]; hole -> miss, else v
+        if (!GetLocal(e, be.propBVKeyLocal) ||
+            !GetLocal(e, be.propTaggedLocal) ||
+            !e.writeOp(Op::I32Const) || !e.writeVarS32(8) ||
+            !e.writeOp(Op::I32Mul) || !e.writeOp(Op::I32Add) ||
+            !e.writeOp(Op::I64Load) || !e.writeVarU32(3) ||
+            !e.writeVarU32(0) || !e.writeOp(Op::LocalTee) ||
+            !e.writeVarU32(be.unboxScratch) ||
+            !e.writeOp(Op::I64Const) || !e.writeVarS64(holeBits) ||
+            !e.writeOp(Op::I64Eq))
+          return false;
+        if (!e.writeOp(Op::If) || !e.writeFixedU8(I64T)) return false;
+        if (!mbvMiss()) return false;
+        if (!e.writeOp(Op::Else)) return false;
+        if (!GetLocal(e, be.unboxScratch)) return false;
+        if (!e.writeOp(Op::End)) return false;   // end is-hole
+        if (!e.writeOp(Op::Else)) return false;  // OOB
+        if (!mbvMiss()) return false;
+        if (!e.writeOp(Op::End)) return false;   // end in-bounds
+        if (!e.writeOp(Op::Else)) return false;  // non-dense class
+        if (!mbvMiss()) return false;
+        if (!e.writeOp(Op::End)) return false;   // end class
+        if (!e.writeOp(Op::Else)) return false;  // non-int key
+        if (keyTy == MIRType::Int32) {
+          if (!mbvMiss()) return false;
+          if (!e.writeOp(Op::End)) return false;
+          if (wrapObjIf) {
+            if (!e.writeOp(Op::Else)) return false;
+            if (!mbvMiss()) return false;
+            if (!e.writeOp(Op::End)) return false;
+          }
+          return true;
+        }
+        // Value key: non-int payload falls to the string-atom probe.
+      }
+    }
+  }
+  // idVal tag == JSVAL_TAG_STRING ?
+  if (!GetOp(e, be, keyDef) || !e.writeOp(Op::I64Const) ||
+      !e.writeVarS64(32) || !e.writeOp(Op::I64ShrU) ||
+      !e.writeOp(Op::I32WrapI64) ||
+      !e.writeOp(Op::I32Const) ||
+      !e.writeVarS32(int32_t(uint32_t(JSVAL_TAG_STRING))) ||
+      !e.writeOp(Op::I32Eq))
+    return false;
+  if (!e.writeOp(Op::If) || !e.writeFixedU8(I64T)) return false;  // is-string
+  // strptr -> propKeyLocal
+  if (!GetOp(e, be, keyDef) || !e.writeOp(Op::I32WrapI64) ||
+      !e.writeOp(Op::LocalSet) || !e.writeVarU32(be.propBVKeyLocal))
+    return false;
+  // atom? flags & ATOM_BIT
+  if (!GetLocal(e, be.propBVKeyLocal) || !e.writeOp(Op::I32Load) ||
+      !e.writeVarU32(2) || !e.writeVarU32(flagsOff) ||
+      !e.writeOp(Op::I32Const) ||
+      !e.writeVarS32(ATOMB) || !e.writeOp(Op::I32And))
+    return false;
+  if (!e.writeOp(Op::If) || !e.writeFixedU8(I64T)) return false;  // is-atom
+  // entry ptr -> propTaggedLocal: ((shape>>S1 ^ shape>>S2)+keyHash) & (N-1) *size + base
+  if (!GetLocal(e, be.propShapeLocal) || !e.writeOp(Op::I32Const) ||
+      !e.writeVarS32(MC::ShapeHashShift1) || !e.writeOp(Op::I32ShrU) ||
+      !GetLocal(e, be.propShapeLocal) || !e.writeOp(Op::I32Const) ||
+      !e.writeVarS32(MC::ShapeHashShift2) || !e.writeOp(Op::I32ShrU) ||
+      !e.writeOp(Op::I32Xor))
+    return false;
+  // + keyHash: I32Load at propKeyLocal + (isFatInline ? fatHashOff : normHashOff)
+  if (!GetLocal(e, be.propBVKeyLocal) || !e.writeOp(Op::I32Const) ||
+      !e.writeVarS32(int32_t(fatHashOff)) || !e.writeOp(Op::I32Const) ||
+      !e.writeVarS32(int32_t(normHashOff)) ||
+      !GetLocal(e, be.propBVKeyLocal) ||
+      !e.writeOp(Op::I32Load) || !e.writeVarU32(2) ||
+      !e.writeVarU32(flagsOff) ||
+      !e.writeOp(Op::I32Const) || !e.writeVarS32(FATM) ||
+      !e.writeOp(Op::I32And) ||
+      !e.writeOp(Op::I32Const) || !e.writeVarS32(FATM) ||
+      !e.writeOp(Op::I32Eq) ||
+      !e.writeOp(Op::SelectNumeric) || !e.writeOp(Op::I32Add) ||
+      !e.writeOp(Op::I32Load) || !e.writeVarU32(2) ||
+      !e.writeVarU32(0) ||
+      !e.writeOp(Op::I32Add))
+    return false;
+  if (!e.writeOp(Op::I32Const) ||
+      !e.writeVarS32(int32_t(MC::NumEntries - 1)) ||
+      !e.writeOp(Op::I32And) || !e.writeOp(Op::I32Const) ||
+      !e.writeVarS32(int32_t(sizeof(MC::Entry))) ||
+      !e.writeOp(Op::I32Mul) || !e.writeOp(Op::I32Const) ||
+      !e.writeVarS32(int32_t(cacheAddr + MC::offsetOfEntries())) ||
+      !e.writeOp(Op::I32Add) || !e.writeOp(Op::LocalSet) ||
+      !e.writeVarU32(be.propTaggedLocal))
+    return false;
+  // cond = e.shape==shape & e.key==keyptr & e.gen==gen & e.hopsAndKind==0
+  if (!GetLocal(e, be.propTaggedLocal) || !e.writeOp(Op::I32Load) ||
+      !e.writeVarU32(2) || !e.writeVarU32(uint32_t(ME::offsetOfShape())) ||
+      !GetLocal(e, be.propShapeLocal) || !e.writeOp(Op::I32Eq))
+    return false;
+  if (!GetLocal(e, be.propTaggedLocal) || !e.writeOp(Op::I32Load) ||
+      !e.writeVarU32(2) || !e.writeVarU32(uint32_t(ME::offsetOfKey())) ||
+      !GetLocal(e, be.propBVKeyLocal) || !e.writeOp(Op::I32Eq) ||
+      !e.writeOp(Op::I32And))
+    return false;
+  if (!GetLocal(e, be.propTaggedLocal) || !e.writeOp(Op::I32Load16U) ||
+      !e.writeVarU32(1) || !e.writeVarU32(uint32_t(ME::offsetOfGeneration())) ||
+      !e.writeOp(Op::I32Const) ||
+      !e.writeVarS32(int32_t(cacheAddr + MC::offsetOfGeneration())) ||
+      !e.writeOp(Op::I32Load16U) || !e.writeVarU32(1) ||
+      !e.writeVarU32(0) ||
+      !e.writeOp(Op::I32Eq) || !e.writeOp(Op::I32And))
+    return false;
+  if (!e.writeOp(Op::If) || !e.writeFixedU8(I64T)) return false;  // entry ok
+  // hk = hopsAndKind. 254=missing->undefined ; bit7->accessor/missing-own
+  // (miss) ; else hk=hops: walk proto chain then load the holder's slot.
+  if (!GetLocal(e, be.propTaggedLocal) || !e.writeOp(Op::I32Load8U) ||
+      !e.writeVarU32(0) ||
+      !e.writeVarU32(uint32_t(ME::offsetOfHopsAndKind())) ||
+      !e.writeOp(Op::LocalTee) || !e.writeVarU32(be.propBVKeyLocal) ||
+      !e.writeOp(Op::I32Const) || !e.writeVarS32(254) ||
+      !e.writeOp(Op::I32Eq))
+    return false;
+  if (!e.writeOp(Op::If) || !e.writeFixedU8(I64T)) return false;  // missing
+  if (!bump(5) || !e.writeOp(Op::I64Const) ||
+      !e.writeVarS64(int64_t(JS::UndefinedValue().asRawBits())))
+    return false;
+  if (!e.writeOp(Op::Else)) return false;
+  if (!GetLocal(e, be.propBVKeyLocal) || !e.writeOp(Op::I32Const) ||
+      !e.writeVarS32(128) || !e.writeOp(Op::I32And))
+    return false;
+  if (!e.writeOp(Op::If) || !e.writeFixedU8(I64T)) return false;  // accessor
+  if (!bump(6) || !mbvMiss()) return false;
+  if (!e.writeOp(Op::Else)) return false;
+  if (!bump(0)) return false;
+  // holder = obj ; for (n=hk; n; n--) holder = holder->shape->base->proto
+  if (!GetLocal(e, be.propObjLocal) || !e.writeOp(Op::LocalSet) ||
+      !e.writeVarU32(be.propShapeLocal))
+    return false;
+  if (!e.writeOp(Op::Block) || !e.writeFixedU8(0x40)) return false;
+  if (!e.writeOp(Op::Loop) || !e.writeFixedU8(0x40)) return false;
+  if (!GetLocal(e, be.propBVKeyLocal) || !e.writeOp(Op::I32Eqz))
+    return false;
+  if (!e.writeOp(Op::BrIf) || !e.writeVarU32(1)) return false;
+  if (!GetLocal(e, be.propShapeLocal) || !e.writeOp(Op::I32Load) ||
+      !e.writeVarU32(2) || !e.writeVarU32(shapeOff) ||
+      !e.writeOp(Op::I32Load) || !e.writeVarU32(2) ||
+      !e.writeVarU32(uint32_t(js::Shape::offsetOfBaseShape())) ||
+      !e.writeOp(Op::I32Load) || !e.writeVarU32(2) ||
+      !e.writeVarU32(uint32_t(js::BaseShape::offsetOfProto())) ||
+      !e.writeOp(Op::LocalSet) || !e.writeVarU32(be.propShapeLocal))
+    return false;
+  if (!GetLocal(e, be.propBVKeyLocal) || !e.writeOp(Op::I32Const) ||
+      !e.writeVarS32(1) || !e.writeOp(Op::I32Sub) ||
+      !e.writeOp(Op::LocalSet) || !e.writeVarU32(be.propBVKeyLocal))
+    return false;
+  if (!e.writeOp(Op::Br) || !e.writeVarU32(0)) return false;
+  if (!e.writeOp(Op::End)) return false;   // end loop
+  if (!e.writeOp(Op::End)) return false;   // end block
+  // slotOffset -> propBVKeyLocal ; base=(tag&1)?holder:holder->slots ; load
+  if (!GetLocal(e, be.propTaggedLocal) || !e.writeOp(Op::I32Load) ||
+      !e.writeVarU32(2) ||
+      !e.writeVarU32(uint32_t(ME::offsetOfSlotOffset())) ||
+      !e.writeOp(Op::LocalSet) || !e.writeVarU32(be.propBVKeyLocal))
+    return false;
+  if (!GetLocal(e, be.propShapeLocal) || !GetLocal(e, be.propShapeLocal) ||
+      !e.writeOp(Op::I32Load) || !e.writeVarU32(2) ||
+      !e.writeVarU32(slotsOff) ||
+      !GetLocal(e, be.propBVKeyLocal) || !e.writeOp(Op::I32Const) ||
+      !e.writeVarS32(1) || !e.writeOp(Op::I32And) ||
+      !e.writeOp(Op::SelectNumeric))
+    return false;
+  if (!GetLocal(e, be.propBVKeyLocal) || !e.writeOp(Op::I32Const) ||
+      !e.writeVarS32(1) || !e.writeOp(Op::I32ShrU) ||
+      !e.writeOp(Op::I32Add) ||
+      !e.writeOp(Op::I64Load) || !e.writeVarU32(3) || !e.writeVarU32(0))
+    return false;
+  if (!e.writeOp(Op::End)) return false;   // close accessor-if
+  if (!e.writeOp(Op::End)) return false;   // close missing-if
+  if (!e.writeOp(Op::Else)) return false;  // cache miss
+  if (!bump(1) || !mbvMiss()) return false;
+  if (!e.writeOp(Op::End)) return false;   // close hit-if
+  if (!e.writeOp(Op::Else)) return false;  // non-atom
+  if (!bump(2) || !mbvMiss()) return false;
+  if (!e.writeOp(Op::End)) return false;   // close atom-if
+  if (!e.writeOp(Op::Else)) return false;  // non-string
+  if (!bump(3) || !mbvMiss()) return false;
+  if (!e.writeOp(Op::End)) return false;   // close string-if
+  if (wrappedValueKey && !e.writeOp(Op::End)) return false;  // int-key
+  if (wrapObjIf) {
+    if (!e.writeOp(Op::Else)) return false;  // non-object receiver
+    if (!bump(4) || !mbvMiss()) return false;
+    if (!e.writeOp(Op::End)) return false;
+  }
+  if (dbgGate)
+    fprintf(stderr, "[megaprobe] emitted op=%d site=%u\n", int(ins->op()),
+            missSite);
+  return true;
+}
+
+// obj[k]=v megamorphic STORE probe (MegamorphicSetElement). Two inline arms:
+//  A) int key + Array|Plain dense elements + idx<initLen + elements not FROZEN
+//     -> pre-barrier + inline elements store + post-barrier.
+//  B) atom key -> MegamorphicSetPropCache probe -> set-existing (afterShape==0)
+//     only: pre-barrier + slot store + post-barrier. Property-ADDs
+//     (afterShape!=0, incl. capacity grows), misses and non-atom keys take the
+//     generic helper (which also fills the set cache). Leaves nothing on the
+//     stack. GECKO_WJ_NOMSEPROBE disables (caller falls back too).
+static bool EmitByValMegaStoreProbe(Encoder& e, WJBackend& be,
+                                    MInstruction* ins, MDefinition* objDef,
+                                    MDefinition* keyDef, MDefinition* valDef,
+                                    bool strict) {
+  MIRType objTy = objDef->type();
+  if (objTy != MIRType::Object && objTy != MIRType::Value) return false;
+  MIRType keyTy = keyDef->type();
+  if (keyTy != MIRType::Value && keyTy != MIRType::Int32) return false;
+  JSContext* mbvCx = js::TlsContext.get();
+  if (!mbvCx) return false;
+  js::MegamorphicSetPropCache* spc =
+      mbvCx->runtime()->caches().megamorphicSetPropCache.get();
+  if (!spc) return false;
+  uintptr_t cacheAddr = uintptr_t(spc);
+  uint32_t strictBit = strict ? 1u : 0u;
+  auto sMiss = [&]() -> bool {
+    return EmitStageScratch(e, be, objDef, 0) &&
+           EmitStageScratch(e, be, keyDef, 1) &&
+           EmitStageScratch(e, be, valDef, 2) &&
+           EmitHelperCallResult(e, be, ins, WJH_SETPROP, strictBit | (5 << 16)) &&
+           e.writeOp(Op::Drop);
+  };
+  using SC = js::MegamorphicSetPropCache;
+  using SCE = js::MegamorphicSetPropCacheEntry;
+  const uint32_t flagsOff = uint32_t(JSString::offsetOfFlags());
+  const int32_t ATOMB = int32_t(js::StringFlags::ATOM_BIT);
+  const int32_t FATM = int32_t(js::StringFlags::FAT_INLINE_MASK);
+  const uint32_t fatHashOff = uint32_t(js::FatInlineAtom::offsetOfHash());
+  const uint32_t normHashOff = uint32_t(js::NormalAtom::offsetOfHash());
+  const uint32_t shapeOff = uint32_t(offsetof(JS::shadow::Object, shape));
+  const uint32_t slotsOff = uint32_t(js::NativeObject::offsetOfSlots());
+  const uint32_t elemsOff = uint32_t(js::NativeObject::offsetOfElements());
+  const int32_t offIL = js::ObjectElements::offsetOfInitializedLength();
+  const int32_t offFlags = js::ObjectElements::offsetOfFlags();
+  const int32_t offCap = js::ObjectElements::offsetOfCapacity();
+  const int32_t offLen = js::ObjectElements::offsetOfLength();
+  const uint32_t FROZENB = 0x40;  // ObjectElements::FROZEN
+  static int mseProf = WJGETENV("GECKO_WJ_SETPROPHIST") ? 1 : 0;
+  auto bump = [&](int i) -> bool {
+    if (!mseProf) return true;
+    uintptr_t a = uintptr_t(&gWJMseProbe[i]);
+    return e.writeOp(Op::I32Const) && e.writeVarS32(int32_t(a)) &&
+           e.writeOp(Op::I32Const) && e.writeVarS32(int32_t(a)) &&
+           e.writeOp(Op::I32Load) && e.writeVarU32(2) && e.writeVarU32(0) &&
+           e.writeOp(Op::I32Const) && e.writeVarS32(1) &&
+           e.writeOp(Op::I32Add) && e.writeOp(Op::I32Store) &&
+           e.writeVarU32(2) && e.writeVarU32(0);
+  };
+  auto boxedStore = [&](uint32_t slotAddrLocal) -> bool {
+    // slotAddr + boxed value -> i64 store; then post-barrier.
+    return GetLocal(e, slotAddrLocal) &&
+           EmitCanonStoreValue(e, be, valDef) && e.writeOp(Op::I64Store) &&
+           e.writeVarU32(3) && e.writeVarU32(0) &&
+           EmitForcePostBarrier(e, be, objDef, valDef);
+  };
+  // slotOff is in propBVKeyLocal; recompute slotAddr from a GC-CURRENT obj
+  // (the pre-barrier's wjhelp call may have moved obj and slots_). Result:
+  // i32 slot address on stack.
+  auto recomputeSlotAddr = [&]() -> bool {
+    // base = (slotOff & 1) ? obj : obj->slots_
+    if (!GetOp(e, be, objDef)) return false;
+    if (objTy == MIRType::Value && !e.writeOp(Op::I32WrapI64)) return false;
+    if (!GetOp(e, be, objDef)) return false;
+    if (objTy == MIRType::Value && !e.writeOp(Op::I32WrapI64)) return false;
+    if (!e.writeOp(Op::I32Load) || !e.writeVarU32(2) ||
+        !e.writeVarU32(slotsOff) || !GetLocal(e, be.propBVKeyLocal) ||
+        !e.writeOp(Op::I32Const) || !e.writeVarS32(1) ||
+        !e.writeOp(Op::I32And) || !e.writeOp(Op::SelectNumeric))
+      return false;
+    // + (slotOff >> 1)
+    if (!GetLocal(e, be.propBVKeyLocal) || !e.writeOp(Op::I32Const) ||
+        !e.writeVarS32(1) || !e.writeOp(Op::I32ShrU) || !e.writeOp(Op::I32Add))
+      return false;
+    return true;
+  };
+  bool wrapObjIf = (objTy == MIRType::Value);
+  if (wrapObjIf) {
+    if (!GetOp(e, be, objDef) || !e.writeOp(Op::I64Const) ||
+        !e.writeVarS64(32) || !e.writeOp(Op::I64ShrU) ||
+        !e.writeOp(Op::I32WrapI64) || !e.writeOp(Op::I32Const) ||
+        !e.writeVarS32(int32_t(uint32_t(JSVAL_TAG_OBJECT))) ||
+        !e.writeOp(Op::I32Eq))
+      return false;
+    if (!e.writeOp(Op::If) || !e.writeFixedU8(0x40)) return false;
+    if (!GetOp(e, be, objDef) || !e.writeOp(Op::I32WrapI64)) return false;
+  } else if (!GetOp(e, be, objDef)) {
+    return false;
+  }
+  if (!e.writeOp(Op::LocalSet) || !e.writeVarU32(be.propObjLocal) ||
+      !GetLocal(e, be.propObjLocal) || !e.writeOp(Op::I32Load) ||
+      !e.writeVarU32(2) || !e.writeVarU32(shapeOff) ||
+      !e.writeOp(Op::LocalSet) || !e.writeVarU32(be.propShapeLocal))
+    return false;
+  if (!bump(0)) return false;
+  const bool wrappedValueKey = keyTy == MIRType::Value;
+  // ---- ARM A: dense int-key element store ----
+  {
+    const uint32_t baseOff = uint32_t(js::Shape::offsetOfBaseShape());
+    const uint32_t claspOff = uint32_t(js::BaseShape::offsetOfClasp());
+    const uint32_t arrCls = uint32_t(uintptr_t(&js::ArrayObject::class_));
+    const uint32_t plainCls = uint32_t(uintptr_t(&js::PlainObject::class_));
+    // cond: int-typed key
+    if (keyTy == MIRType::Value) {
+      if (!GetOp(e, be, keyDef) || !e.writeOp(Op::I64Const) ||
+          !e.writeVarS64(32) || !e.writeOp(Op::I64ShrU) ||
+          !e.writeOp(Op::I32WrapI64) || !e.writeOp(Op::I32Const) ||
+          !e.writeVarS32(int32_t(uint32_t(JSVAL_TAG_INT32))) ||
+          !e.writeOp(Op::I32Eq))
+        return false;
+    } else if (!e.writeOp(Op::I32Const) || !e.writeVarS32(1)) {
+      return false;
+    }
+    if (!e.writeOp(Op::If) || !e.writeFixedU8(0x40)) return false;
+    // idx -> propBVKeyLocal ; elems -> propTaggedLocal
+    if (!GetOp(e, be, keyDef)) return false;
+    if (keyTy == MIRType::Value && !e.writeOp(Op::I32WrapI64)) return false;
+    if (!e.writeOp(Op::LocalSet) || !e.writeVarU32(be.propBVKeyLocal) ||
+        !GetLocal(e, be.propObjLocal) || !e.writeOp(Op::I32Load) ||
+        !e.writeVarU32(2) || !e.writeVarU32(elemsOff) ||
+        !e.writeOp(Op::LocalSet) || !e.writeVarU32(be.propTaggedLocal))
+      return false;
+    // clasp in {Array, Plain} ?
+    if (!GetLocal(e, be.propShapeLocal) || !e.writeOp(Op::I32Load) ||
+        !e.writeVarU32(2) || !e.writeVarU32(baseOff) ||
+        !e.writeOp(Op::I32Load) || !e.writeVarU32(2) ||
+        !e.writeVarU32(claspOff) || !e.writeOp(Op::LocalTee) ||
+        !e.writeVarU32(be.propShapeLocal) ||
+        !e.writeOp(Op::I32Const) || !e.writeVarS32(int32_t(arrCls)) ||
+        !e.writeOp(Op::I32Eq) || !GetLocal(e, be.propShapeLocal) ||
+        !e.writeOp(Op::I32Const) || !e.writeVarS32(int32_t(plainCls)) ||
+        !e.writeOp(Op::I32Eq) || !e.writeOp(Op::I32Or))
+      return false;
+    if (!e.writeOp(Op::If) || !e.writeFixedU8(0x40)) return false;
+    if (!bump(1)) return false;
+    // in-bounds && not frozen ?
+    if (!GetLocal(e, be.propBVKeyLocal) ||
+        !GetLocal(e, be.propTaggedLocal) || !e.writeOp(Op::I32Const) ||
+        !e.writeVarS32(offIL) || !e.writeOp(Op::I32Add) ||
+        !e.writeOp(Op::I32Load) || !e.writeVarU32(2) ||
+        !e.writeVarU32(0) || !e.writeOp(Op::I32LtU))
+      return false;
+    if (!GetLocal(e, be.propTaggedLocal) || !e.writeOp(Op::I32Const) ||
+        !e.writeVarS32(offFlags) || !e.writeOp(Op::I32Add) ||
+        !e.writeOp(Op::I32Load) || !e.writeVarU32(2) ||
+        !e.writeVarU32(0) || !e.writeOp(Op::I32Const) ||
+        !e.writeVarS32(int32_t(FROZENB)) || !e.writeOp(Op::I32And) ||
+        !e.writeOp(Op::I32Eqz) || !e.writeOp(Op::I32And))
+      return false;
+    if (!e.writeOp(Op::If) || !e.writeFixedU8(0x40)) return false;
+    // slotAddr = elems + idx*8 -> propTaggedLocal
+    if (!GetLocal(e, be.propTaggedLocal) ||
+        !GetLocal(e, be.propBVKeyLocal) || !e.writeOp(Op::I32Const) ||
+        !e.writeVarS32(8) || !e.writeOp(Op::I32Mul) ||
+        !e.writeOp(Op::I32Add) || !e.writeOp(Op::LocalSet) ||
+        !e.writeVarU32(be.propTaggedLocal))
+      return false;
+    if (!EmitGuardedValuePreBarrier(e, be, [&]() {
+          return GetLocal(e, be.propTaggedLocal) && e.writeOp(Op::I64Load) &&
+                 e.writeVarU32(3) && e.writeVarU32(0);
+        }))
+      return false;
+    // Recompute slotAddr post-call: obj->elements_ + idx*8.
+    if (!GetOp(e, be, objDef)) return false;
+    if (objTy == MIRType::Value && !e.writeOp(Op::I32WrapI64)) return false;
+    if (!e.writeOp(Op::I32Load) || !e.writeVarU32(2) ||
+        !e.writeVarU32(elemsOff) || !GetLocal(e, be.propBVKeyLocal) ||
+        !e.writeOp(Op::I32Const) || !e.writeVarS32(8) ||
+        !e.writeOp(Op::I32Mul) || !e.writeOp(Op::I32Add) ||
+        !e.writeOp(Op::LocalSet) || !e.writeVarU32(be.propTaggedLocal))
+      return false;
+    if (!boxedStore(be.propTaggedLocal)) return false;
+    if (!bump(2)) return false;
+    if (!e.writeOp(Op::Else)) return false;
+    // EXTENSION arm: contiguous append (idx == initLen) within capacity on
+    // extensible+writable elements. Store value, bump initLen (+length for
+    // arrays); longer-range/gapped writes take the helper.
+    // cond = idx==initLen && idx<capacity && (flags & 0x70)==0
+    //        && (idx < length || !(flags & NONWRITABLE_ARRAY_LENGTH))
+    if (!GetLocal(e, be.propBVKeyLocal) ||
+        !GetLocal(e, be.propTaggedLocal) || !e.writeOp(Op::I32Const) ||
+        !e.writeVarS32(offIL) || !e.writeOp(Op::I32Add) ||
+        !e.writeOp(Op::I32Load) || !e.writeVarU32(2) ||
+        !e.writeVarU32(0) || !e.writeOp(Op::I32Eq))
+      return false;
+    if (!GetLocal(e, be.propBVKeyLocal) ||
+        !GetLocal(e, be.propTaggedLocal) || !e.writeOp(Op::I32Const) ||
+        !e.writeVarS32(offCap) || !e.writeOp(Op::I32Add) ||
+        !e.writeOp(Op::I32Load) || !e.writeVarU32(2) ||
+        !e.writeVarU32(0) || !e.writeOp(Op::I32LtU) ||
+        !e.writeOp(Op::I32And))
+      return false;
+    if (!GetLocal(e, be.propTaggedLocal) || !e.writeOp(Op::I32Const) ||
+        !e.writeVarS32(offFlags) || !e.writeOp(Op::I32Add) ||
+        !e.writeOp(Op::I32Load) || !e.writeVarU32(2) ||
+        !e.writeVarU32(0) || !e.writeOp(Op::I32Const) ||
+        !e.writeVarS32(0x70) || !e.writeOp(Op::I32And) ||
+        !e.writeOp(Op::I32Eqz) || !e.writeOp(Op::I32And))
+      return false;
+    if (!GetLocal(e, be.propBVKeyLocal) ||
+        !GetLocal(e, be.propTaggedLocal) || !e.writeOp(Op::I32Const) ||
+        !e.writeVarS32(offLen) || !e.writeOp(Op::I32Add) ||
+        !e.writeOp(Op::I32Load) || !e.writeVarU32(2) ||
+        !e.writeVarU32(0) || !e.writeOp(Op::I32LtU))
+      return false;
+    if (!GetLocal(e, be.propTaggedLocal) || !e.writeOp(Op::I32Const) ||
+        !e.writeVarS32(offFlags) || !e.writeOp(Op::I32Add) ||
+        !e.writeOp(Op::I32Load) || !e.writeVarU32(2) ||
+        !e.writeVarU32(0) || !e.writeOp(Op::I32Const) ||
+        !e.writeVarS32(0x2) || !e.writeOp(Op::I32And) ||
+        !e.writeOp(Op::I32Eqz) || !e.writeOp(Op::I32Or) ||
+        !e.writeOp(Op::I32And))
+      return false;
+    if (!e.writeOp(Op::If) || !e.writeFixedU8(0x40)) return false;
+    // slotAddr = elems + idx*8 -> iterIdx (keep propTaggedLocal = elems)
+    if (!GetLocal(e, be.propTaggedLocal) ||
+        !GetLocal(e, be.propBVKeyLocal) || !e.writeOp(Op::I32Const) ||
+        !e.writeVarS32(8) || !e.writeOp(Op::I32Mul) ||
+        !e.writeOp(Op::I32Add) || !e.writeOp(Op::LocalSet) ||
+        !e.writeVarU32(be.iterIdx))
+      return false;
+    if (!GetLocal(e, be.iterIdx) ||
+        !EmitCanonStoreValue(e, be, valDef) || !e.writeOp(Op::I64Store) ||
+        !e.writeVarU32(3) || !e.writeVarU32(0))
+      return false;
+    // initLen = idx+1
+    if (!GetLocal(e, be.propTaggedLocal) || !e.writeOp(Op::I32Const) ||
+        !e.writeVarS32(offIL) || !e.writeOp(Op::I32Add) ||
+        !GetLocal(e, be.propBVKeyLocal) || !e.writeOp(Op::I32Const) ||
+        !e.writeVarS32(1) || !e.writeOp(Op::I32Add) ||
+        !e.writeOp(Op::I32Store) || !e.writeVarU32(2) ||
+        !e.writeVarU32(0))
+      return false;
+    // Array only: elems->length = max(length, idx+1)
+    if (!GetLocal(e, be.propShapeLocal) || !e.writeOp(Op::I32Const) ||
+        !e.writeVarS32(int32_t(arrCls)) || !e.writeOp(Op::I32Eq))
+      return false;
+    if (!e.writeOp(Op::If) || !e.writeFixedU8(0x40)) return false;
+    // addr = elems+offLen
+    if (!GetLocal(e, be.propTaggedLocal) || !e.writeOp(Op::I32Const) ||
+        !e.writeVarS32(offLen) || !e.writeOp(Op::I32Add))
+      return false;
+    // select(idx+1, curLen, idx+1>curLen)
+    if (!GetLocal(e, be.propBVKeyLocal) || !e.writeOp(Op::I32Const) ||
+        !e.writeVarS32(1) || !e.writeOp(Op::I32Add))
+      return false;
+    if (!GetLocal(e, be.propTaggedLocal) || !e.writeOp(Op::I32Const) ||
+        !e.writeVarS32(offLen) || !e.writeOp(Op::I32Add) ||
+        !e.writeOp(Op::I32Load) || !e.writeVarU32(2) || !e.writeVarU32(0))
+      return false;
+    if (!GetLocal(e, be.propBVKeyLocal) || !e.writeOp(Op::I32Const) ||
+        !e.writeVarS32(1) || !e.writeOp(Op::I32Add))
+      return false;
+    if (!GetLocal(e, be.propTaggedLocal) || !e.writeOp(Op::I32Const) ||
+        !e.writeVarS32(offLen) || !e.writeOp(Op::I32Add) ||
+        !e.writeOp(Op::I32Load) || !e.writeVarU32(2) || !e.writeVarU32(0))
+      return false;
+    if (!e.writeOp(Op::I32GtU) || !e.writeOp(Op::SelectNumeric) ||
+        !e.writeOp(Op::I32Store) || !e.writeVarU32(2) ||
+        !e.writeVarU32(0))
+      return false;
+    if (!e.writeOp(Op::End)) return false;   // end array-length
+    if (!EmitForcePostBarrier(e, be, objDef, valDef)) return false;
+    if (!bump(12)) return false;
+    if (!e.writeOp(Op::Else)) return false;
+    if (!bump(3) || !sMiss()) return false;
+    if (!e.writeOp(Op::End)) return false;   // end extension
+    if (!e.writeOp(Op::End)) return false;   // end in-bounds/not-frozen
+    if (!e.writeOp(Op::Else)) return false;
+    if (!bump(4) || !sMiss()) return false;
+    if (!e.writeOp(Op::End)) return false;   // end clasp
+    if (!e.writeOp(Op::Else)) return false;
+    // (for Value keys the string/atom arm runs inside this else; for Int32
+    // keys there is no other arm -> generic helper)
+    if (!wrappedValueKey && !sMiss()) return false;
+  }
+  // ---- ARM B: atom-key set-prop-cache probe (Value keys only) ----
+  if (wrappedValueKey) {
+    // Reload obj->shape (clobbered by the clasp check above).
+    if (!GetLocal(e, be.propObjLocal) || !e.writeOp(Op::I32Load) ||
+        !e.writeVarU32(2) || !e.writeVarU32(shapeOff) ||
+        !e.writeOp(Op::LocalSet) || !e.writeVarU32(be.propShapeLocal))
+      return false;
+    if (!GetOp(e, be, keyDef) || !e.writeOp(Op::I64Const) ||
+        !e.writeVarS64(32) || !e.writeOp(Op::I64ShrU) ||
+        !e.writeOp(Op::I32WrapI64) || !e.writeOp(Op::I32Const) ||
+        !e.writeVarS32(int32_t(uint32_t(JSVAL_TAG_STRING))) ||
+        !e.writeOp(Op::I32Eq))
+      return false;
+    if (!e.writeOp(Op::If) || !e.writeFixedU8(0x40)) return false;
+    // strptr -> propBVKeyLocal
+    if (!GetOp(e, be, keyDef) || !e.writeOp(Op::I32WrapI64) ||
+        !e.writeOp(Op::LocalSet) || !e.writeVarU32(be.propBVKeyLocal))
+      return false;
+    if (!GetLocal(e, be.propBVKeyLocal) || !e.writeOp(Op::I32Load) ||
+        !e.writeVarU32(2) || !e.writeVarU32(flagsOff) ||
+        !e.writeOp(Op::I32Const) || !e.writeVarS32(ATOMB) ||
+        !e.writeOp(Op::I32And))
+      return false;
+    if (!e.writeOp(Op::If) || !e.writeFixedU8(0x40)) return false;
+    if (!bump(5)) return false;
+    // entry = entries[((shape>>S1 ^ shape>>S2) + keyHash) & (N-1)]
+    if (!GetLocal(e, be.propShapeLocal) || !e.writeOp(Op::I32Const) ||
+        !e.writeVarS32(SC::ShapeHashShift1) || !e.writeOp(Op::I32ShrU) ||
+        !GetLocal(e, be.propShapeLocal) || !e.writeOp(Op::I32Const) ||
+        !e.writeVarS32(SC::ShapeHashShift2) || !e.writeOp(Op::I32ShrU) ||
+        !e.writeOp(Op::I32Xor))
+      return false;
+    if (!GetLocal(e, be.propBVKeyLocal) || !e.writeOp(Op::I32Const) ||
+        !e.writeVarS32(int32_t(fatHashOff)) || !e.writeOp(Op::I32Const) ||
+        !e.writeVarS32(int32_t(normHashOff)) ||
+        !GetLocal(e, be.propBVKeyLocal) || !e.writeOp(Op::I32Load) ||
+        !e.writeVarU32(2) || !e.writeVarU32(flagsOff) ||
+        !e.writeOp(Op::I32Const) || !e.writeVarS32(FATM) ||
+        !e.writeOp(Op::I32And) || !e.writeOp(Op::I32Const) ||
+        !e.writeVarS32(FATM) || !e.writeOp(Op::I32Eq) ||
+        !e.writeOp(Op::SelectNumeric) || !e.writeOp(Op::I32Add) ||
+        !e.writeOp(Op::I32Load) || !e.writeVarU32(2) ||
+        !e.writeVarU32(0) || !e.writeOp(Op::I32Add))
+      return false;
+    if (!e.writeOp(Op::I32Const) ||
