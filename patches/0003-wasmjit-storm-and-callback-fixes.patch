+    if (!GetLocal(e, be.propShapeLocal) || !e.writeOp(Op::I32Const) ||
+        !e.writeVarS32(1) || !e.writeOp(Op::I32Sub) ||
+        !e.writeOp(Op::LocalSet) || !e.writeVarU32(be.propShapeLocal) ||
+        !loadChar(be.propBVKeyLocal, ld1, sh1) ||
+        !loadChar(be.propTaggedLocal, ld2, sh2) ||
+        !e.writeOp(Op::I32Eq) || !e.writeOp(Op::BrIf) || !e.writeVarU32(0))
+      return false;
+    if (!e.writeOp(Op::I32Const) || !e.writeVarS32(0) ||
+        !e.writeOp(Op::LocalSet) || !e.writeVarU32(be.propObjLocal) ||
+        !e.writeOp(Op::Br) || !e.writeVarU32(1))
+      return false;
+    if (!e.writeOp(Op::End)) return false;   // loop
+    if (!e.writeOp(Op::End)) return false;   // block
+    // res==0 -> mismatch; res==1 && len<=K -> fully compared equal; res==1 &&
+    // len>K -> still undecided -> helper finishes it.
+    if (!GetLocal(e, be.propObjLocal) || !e.writeOp(Op::If) ||
+        !e.writeFixedU8(kI32))
+      return false;
+    if (!GetLocal(e, be.unboxScratch) || !e.writeOp(Op::I64Const) ||
+        !e.writeVarS64(kScanCap) || !e.writeOp(Op::I64GtU) ||
+        !e.writeOp(Op::If) || !e.writeFixedU8(kI32))
+      return false;
+    if (!miss()) return false;
+    if (!e.writeOp(Op::Else)) return false;
+    if (!GetLocal(e, be.propObjLocal)) return false;
+    if (!e.writeOp(Op::End)) return false;
+    if (!e.writeOp(Op::Else)) return false;
+    if (!e.writeOp(Op::I32Const) || !e.writeVarS32(0)) return false;
+    if (!e.writeOp(Op::End)) return false;
+    return true;
+  };
+  auto latSet = [&](uint32_t floc) -> bool {
+    return GetLocal(e, floc) && e.writeOp(Op::I32Const) &&
+           e.writeVarS32(LAT) && e.writeOp(Op::I32And);
+  };
+  if (!latSet(be.propShapeLocal) || !e.writeOp(Op::If) || !e.writeFixedU8(kI32))
+    return false;
+  if (!latSet(be.propObjLocal) || !e.writeOp(Op::If) || !e.writeFixedU8(kI32))
+    return false;
+  if (!scan(Op::I32Load8U, 0, Op::I32Load8U, 0)) return false;
+  if (!e.writeOp(Op::Else)) return false;
+  if (!scan(Op::I32Load8U, 0, Op::I32Load16U, 1)) return false;
+  if (!e.writeOp(Op::End)) return false;
+  if (!e.writeOp(Op::Else)) return false;
+  if (!latSet(be.propObjLocal) || !e.writeOp(Op::If) || !e.writeFixedU8(kI32))
+    return false;
+  if (!scan(Op::I32Load16U, 1, Op::I32Load8U, 0)) return false;
+  if (!e.writeOp(Op::Else)) return false;
+  if (!scan(Op::I32Load16U, 1, Op::I32Load16U, 1)) return false;
+  if (!e.writeOp(Op::End)) return false;
+  if (!e.writeOp(Op::End)) return false;   // width dispatch
+  if (!e.writeOp(Op::End)) return false;   // len-eq if
+  if (!e.writeOp(Op::Else)) return false;  // not both-linear
+  if (!miss()) return false;
+  if (!e.writeOp(Op::End)) return false;   // lin if
+  if (!e.writeOp(Op::End)) return false;   // s1==s2 if
+  return true;
+}
