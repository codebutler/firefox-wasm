+    return GetLocal(e, floc) && e.writeOp(Op::I32Const) &&
+           e.writeVarS32(LIN) && e.writeOp(Op::I32And);
+  };
+  // both linear (any width pair: lat1/lat1, lat1/2b, 2b/2b -- the per-side
+  // u8/u16 load makes a u8==u16 compare numerically correct).
+  if (!linSet(be.propShapeLocal) || !linSet(be.propObjLocal) ||
+      !e.writeOp(Op::I32And) || !e.writeOp(Op::If) || !e.writeFixedU8(kI32))
