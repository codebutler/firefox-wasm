diff --git a/js/src/vm/Caches.h b/js/src/vm/Caches.h
index 88012d36c0..6f86e1bb18 100644
--- a/js/src/vm/Caches.h
+++ b/js/src/vm/Caches.h
@@ -183,7 +183,7 @@ class MegamorphicCache {
  public:
   using Entry = MegamorphicCacheEntry;
 
-  static constexpr size_t NumEntries = 1024;
+  static constexpr size_t NumEntries = 8192;
   static constexpr uint8_t ShapeHashShift1 = mozilla::FloorLog2(alignof(Shape));
   static constexpr uint8_t ShapeHashShift2 =
