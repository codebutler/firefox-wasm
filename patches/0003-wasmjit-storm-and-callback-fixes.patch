+      !e.writeOp(Op::I32Eq) || !e.writeOp(Op::If) || !e.writeFixedU8(kI32))
+    return false;
+  if (!e.writeOp(Op::I32Const) || !e.writeVarS32(1)) return false;
+  if (!e.writeOp(Op::Else)) return false;
+  // f1 -> propShapeLocal ; f2 -> propObjLocal ; both linear+latin1?
