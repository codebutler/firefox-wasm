+// A windowless browser cannot create new top-level windows. Divert auxiliary
+// window requests (target=_blank, window.open) into the existing content
+// browsing context so they navigate the single window instead of failing.
+NS_IMETHODIMP
+WebBrowserChrome2Stub::ProvideWindow(
+    nsIOpenWindowInfo* aOpenWindowInfo, uint32_t aChromeFlags,
+    bool aCalledFromJS, nsIURI* aURI, const nsAString& aName,
+    const nsACString& aFeatures,
+    const mozilla::dom::UserActivation::Modifiers& aModifiers,
+    bool aForceNoOpener, bool aForceNoReferrer, bool aIsPopupRequested,
+    nsDocShellLoadState* aLoadState, bool* aWindowIsNew,
+    dom::BrowsingContext** aReturn) {
+  *aReturn = nullptr;
+  *aWindowIsNew = false;
+  nsCOMPtr<nsIDocShell> docShell = do_GetInterface(mBrowser);
+  if (docShell) {
+    RefPtr<dom::BrowsingContext> bc = docShell->GetBrowsingContext();
+    bc.forget(aReturn);
+  }
+  return NS_OK;
+}
