diff --git a/js/src/gc/RootMarking.cpp b/js/src/gc/RootMarking.cpp
index 034685eb7c..eda6c580ae 100644
--- a/js/src/gc/RootMarking.cpp
+++ b/js/src/gc/RootMarking.cpp
@@ -39,6 +39,15 @@ using RootEntry = RootedValueMap::Entry;
 // objects held in a Mode VS frame across a safepoint are forwarded (otherwise
 // they go stale on tenuring -> heap corruption).
 extern "C" void WJTraceRoots(JSTracer* trc, void* data);
+// The wasm JIT runs on the main runtime only (patch 0015), so its roots are
+// the main runtime's cells. A worker runtime's GC must not trace them: its
+// major GC would mark (and traverse) main-runtime cells from the worker thread,
+// racing the main thread's marker and mutator (patch 0016).
+// GECKO_WJ_WORKERTRACE=1 traces them from every runtime again (A/B).
+static bool WJTraceRootsFor(JSRuntime* rt) {
+  static int sAll = getenv("GECKO_WJ_WORKERTRACE") ? 1 : 0;
+  return sAll || !rt->parentRuntime;
+}
 #endif
 
 template <typename Base, typename T>
@@ -259,7 +268,9 @@ void js::gc::GCRuntime::traceRuntimeForMajorGC(JSTracer* trc,
   // left gWJPropShape pointing at moved/dead shapes -> a new shape at the old
   // address falsely matched the IC -> wrong slot loaded (raytrace "Scene rendered
   // incorrectly" after enough allocation triggered a compacting GC).
-  WJTraceRoots(trc, nullptr);
+  if (WJTraceRootsFor(rt)) {
+    WJTraceRoots(trc, nullptr);
+  }
 #endif
 }
 
@@ -279,7 +290,9 @@ void js::gc::GCRuntime::traceRuntimeForMinorGC(JSTracer* trc,
   traceRuntimeCommon(trc, TraceRuntime);
 
 #ifdef __EMSCRIPTEN__
-  WJTraceRoots(trc, nullptr);
+  if (WJTraceRootsFor(rt)) {
+    WJTraceRoots(trc, nullptr);
+  }
 #endif
 }
 
