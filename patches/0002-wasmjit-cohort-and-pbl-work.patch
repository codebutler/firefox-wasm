-  *nlocalsOut = info->nlocals();
+  *tblSlotOut = tblSlots[0];
+  *nargsOut = members[0]->nargs;
+  *nlocalsOut = members[0]->nlocals;
+  if (bodyOut) {
+    bodyOut->assign(members[0]->body.begin(),
+                    members[0]->body.begin() + members[0]->body.length());
+  }
