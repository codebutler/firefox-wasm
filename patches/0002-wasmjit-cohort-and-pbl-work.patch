+  // REUSE (deopt-storm recompile keeps the same slot so cached call ICs stay
+  // valid).
+  std::vector<int> tblSlots(1, *tblSlotOut);
+  std::vector<int> memberIdx(1, -1);
+  int handle = AssembleAndInstallN(cx, members, tblSlots, memberIdx, dump);
