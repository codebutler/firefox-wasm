diff --git a/js/src/shell/wizer.cpp b/js/src/shell/wizer.cpp
new file mode 100644
index 0000000000..e13e1a1e20
--- /dev/null
+++ b/js/src/shell/wizer.cpp
@@ -0,0 +1,143 @@
+/* -*- Mode: C++; tab-width: 8; indent-tabs-mode: nil; c-basic-offset: 2 -*-
+ * vim: set ts=8 sts=2 et sw=2 tw=80:
+ * This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+/* Support for Wizer-based snapshotting of the JS shell, when built
+ * for a Wasm target (i.e., running inside a Wasm module). */
+
+#include <wizer.h>
+
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <optional>
+
+#include "js/CallAndConstruct.h"
+#include "js/CompilationAndEvaluation.h"
+#include "js/CompileOptions.h"
+#include "js/Initialization.h"
+#include "js/SourceText.h"
+#include "jsapi.h"
+#include "shell/jsshell.h"
+#include "vm/BytecodeUtil.h"
+#include "vm/JSFunction.h"
+
+using namespace js;
+using namespace js::shell;
+
+#ifdef JS_SHELL_WIZER
+
+static std::optional<JSAndShellContext> wizenedContext;
+
+// During Wizer initialization we compile and run a workload script so
+// that its JSScripts and attached CacheIR stubs have pending weval
+// specialization requests when the module is snapshotted.
+static const char kWorkload[] = R"(
+function iter(x) { return x + 1.5; }
+function m2(x) { return iter(x) + iter(x); }
+function icLoop(o, n) { var acc = 0; for (var i = 0; i < n; i++) { acc += o.a + i; acc += o.b; } return acc; }
+function fib(n) { return n < 2 ? n : fib(n - 1) + fib(n - 2); }
+var gO = {a: 1.5, b: 2.5};
+function warmup() { m2(1); icLoop(gO, 1000); fib(10); }
+function main() {
+  var acc = 0;
+  for (var i = 0; i < 2000000; i++) { acc += m2(i); }
+  return acc + icLoop(gO, 1000);
+}
+)";
+
+static void WizerInit() {
+  const int argc = 3;
+  char* argv[4] = {strdup("js"), strdup("-e"), strdup(""), nullptr};
+
+  auto ret = ShellMain(argc, argv, /* retainContext = */ true);
+  if (!ret.is<JSAndShellContext>()) {
+    fprintf(stderr, "Could not execute shell main during Wizening!\n");
+    abort();
+  }
+
+  wizenedContext = std::move(ret.as<JSAndShellContext>());
+
+  JSContext* cx = wizenedContext->cx;
+  RootedObject glob(cx, wizenedContext->glob);
+  if (!glob) {
+    fprintf(stderr, "No global object after Wizening!\n");
+    abort();
+  }
+  JSAutoRealm ar(cx, glob);
+
+  JS::CompileOptions opts(cx);
+  opts.setFileAndLine("<wizer-workload>", 1);
+  JS::SourceText<mozilla::Utf8Unit> src;
+  if (!src.init(cx, kWorkload, strlen(kWorkload),
+                JS::SourceOwnership::Borrowed)) {
+    abort();
+  }
+  JS::RootedValue rval(cx);
+  if (!JS::Evaluate(cx, opts, src, &rval)) {
+    fprintf(stderr, "Failed to evaluate Wizer workload!\n");
+    abort();
+  }
+
+  {
+    JS::RootedValue mainFn(cx);
+    if (JS_GetProperty(cx, glob, "main", &mainFn) && mainFn.isObject()) {
+      JS::RootedFunction fun(cx, &mainFn.toObject().as<JSFunction>());
+      JSScript* script = JSFunction::getOrCreateScript(cx, fun);
+      if (script) {
+        jsbytecode* pc = script->code();
+        jsbytecode* end = script->codeEnd();
+        while (pc < end) {
+          fprintf(stderr, "  %4u: %s\n", unsigned(pc - script->code()),
+                  js::CodeName(JSOp(*pc)));
+          pc += js::GetBytecodeLength(pc);
+        }
+      }
+    }
+  }
+
+  // Run the workload a few times so IC stubs attach and their weval
+  // specialization requests are enqueued.
+  for (int i = 0; i < 5; i++) {
+    if (!JS_CallFunctionName(cx, glob, "warmup",
+                             JS::HandleValueArray::empty(), &rval)) {
+      fprintf(stderr, "Wizer workload warmup call failed!\n");
+      abort();
+    }
+  }
+  if (!JS_CallFunctionName(cx, glob, "main", JS::HandleValueArray::empty(),
+                           &rval)) {
+    fprintf(stderr, "Wizer workload main call failed!\n");
+    abort();
+  }
+}
+
+WIZER_INIT(WizerInit);
+
+int main(int argc, char** argv) {
+  if (wizenedContext) {
+    JSContext* cx = wizenedContext->cx;
+    RootedObject glob(cx, wizenedContext->glob);
+
+    JSAutoRealm ar(cx, glob);
+
+    // Look up a function called "main" in the global.
+    JS::Rooted<JS::Value> ret(cx);
+    if (!JS_CallFunctionName(cx, glob, "main",
+                             JS::HandleValueArray::empty(), &ret)) {
+      fprintf(stderr, "Failed to call main() in Wizened JS source!\n");
+      abort();
+    }
+    if (!ret.isNumber() || ret.toNumber() != 4000004503500.0) {
+      fprintf(stderr, "main() returned unexpected value!\n");
+      abort();
+    }
+    fprintf(stderr, "main() = %.0f (specialization ok)\n", ret.toNumber());
+    return 0;
+  }
+  return ShellMain(argc, argv, /* retainContext = */ false).as<int>();
+}
+
+#endif  // JS_SHELL_WIZER
