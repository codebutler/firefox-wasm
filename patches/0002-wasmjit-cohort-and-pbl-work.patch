+ * context, and has entries of the form:
+ *
+ * /// Some value pushed onto stack. Not actually stored until
+ * /// state is synced.
+ * struct StackEntry {
+ *     /// The address at which the value is stored.
+ *     stackptr: Value,
+ *     /// The value to store (and return from pops/stack-reads).
+ *     value: Value,
+ * }
+ */
+
