+
+#ifndef vm_Weval_h
+#define vm_Weval_h
+
+#ifdef ENABLE_JS_PBL_WEVAL
+#  include <weval.h>
+#endif
+
+namespace js {
+
+#ifdef ENABLE_JS_PBL_WEVAL
+
+struct Weval {
+  weval_func_t func;
+  weval_req_t* req;
+
+ public:
+  Weval() : func(nullptr), req(nullptr) {}
