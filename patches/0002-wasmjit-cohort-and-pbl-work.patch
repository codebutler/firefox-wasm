+}
+
+// Cohort compile (GECKO_WJ_COHORT): re-emit `reqs` member functions into ONE
+// wasm module/instance. Calls between members then resolve to same-instance
+// call_indirect (V8's speculative wasm inlining only fires when caller and
+// callee share an instance -- measured 2.4-2.7x faster than cross-instance in
+// Chrome). Members keep their scripts'/entries' slots; the cohort is a second,
+// better-connected copy of already-proven code. Returns the module handle or
+// -1 (reqs[].ok/memberIdx/tblSlot/nargs/nlocals fill in per member).
+// reqs[].body must point at the member's cached emitted bytes (WJEntry::jitBody)
+// -- cohort assembly is pure byte copying: no Warp re-run, no script dereference.
+int WJWarpCompileCohort(JSContext* cx, std::vector<WJCohortReq>& reqs) {
+  bool dump = getenv("GECKO_WJWARP_DUMP") || getenv("GECKO_WJ_WASMDUMP");
+  std::vector<std::pair<const uint8_t*, uint32_t>> bodies;
+  std::vector<uint32_t> reqIdx;
+  for (size_t i = 0; i < reqs.size(); i++) {
+    if (!reqs[i].body || reqs[i].body->empty()) continue;
+    reqIdx.push_back(uint32_t(i));
+    bodies.push_back({reqs[i].body->data(), uint32_t(reqs[i].body->size())});
+  }
+  if (bodies.size() < 2) return -1;
+  std::vector<int> tblSlots(bodies.size(), -1), memberIdx(bodies.size(), -1);
+  for (size_t i = 0; i < bodies.size(); i++)
+    tblSlots[i] = reqs[reqIdx[i]].tblSlot;
+  int handle = AssembleBodiesAndInstall(bodies, tblSlots, memberIdx, dump,
+                                        reqs[reqIdx[0]].script);
+  if (handle < 0) return -1;
+  for (size_t i = 0; i < bodies.size(); i++) {
+    if (memberIdx[i] < 0) continue;
+    WJCohortReq& r = reqs[reqIdx[i]];
+    r.ok = true;
+    r.memberIdx = memberIdx[i];
+    r.tblSlot = tblSlots[i];
+  }
+  gWJCompileSerial++;
+  static int instlog = getenv("GECKO_WJ_INSTLOG") ? 1 : 0;
+  if (dump || instlog)
+    fprintf(stderr, "[wb-cohort] installed #%u members=%u handle=%d\n",
+            gWJCompileSerial, unsigned(bodies.size()), handle);
   return handle;
 }
 
