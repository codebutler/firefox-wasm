+                   : ((gWJNextTblSlot < kWJTableSize) ? gWJNextTblSlot++ : -1);
+    if (slot >= 0) (void)wasmhost_jit_table_set(handle, slot, int(c));
+    tblSlots[c] = slot;
+    memberIdx[c] = int(c);
+  }
+  return handle;
+}
+
+// Assemble members into ONE module and host-install. tblSlots/memberIdx are
+// parallel to `members`: tblSlots[i] in = preferred slot (recompile keeps the
+// slot so callers' cached ICs stay valid; -1 = allocate fresh), out = actual;
+// memberIdx[i] out = this member's trampoline export position (-1 if dropped).
+// Members whose emit bails are dropped; an empty cohort fails.
+static int AssembleAndInstallN(
+    JSContext* cx, std::vector<std::unique_ptr<WJMemberBuild>>& members,
+    std::vector<int>& tblSlots, std::vector<int>& memberIdx, bool dump) {
+  {
+    JitContext jctx(cx);  // emit phase; sequential per member (no nesting)
+    for (auto& mb : members) WJEmitMemberBody(*mb);
+  }
+  std::vector<std::pair<const uint8_t*, uint32_t>> bodies;
+  std::vector<uint32_t> live;
+  for (uint32_t i = 0; i < members.size(); i++) {
+    memberIdx[i] = -1;
+    if (members[i]->emitted) live.push_back(i);
+  }
+  uint32_t n = uint32_t(live.size());
+  if (!n) {
+    if (dump)
+      fprintf(stderr, "[wb-compile] WJEmitBody bailed (unsupported node)\n");
+    static int cdbg = getenv("GECKO_WJ_CDBG") ? 1 : 0;
+    if (cdbg)
+      fprintf(stderr, "[wj-cdbg] BAIL line=%u reason=%s\n",
+              js::wasm::gWJBailLine, js::wasm::gWJBailReason);
+    return -1;
+  }
+  std::vector<int> liveSlots(n), liveIdx(n);
+  for (uint32_t c = 0; c < n; c++) {
+    liveSlots[c] = tblSlots[live[c]];
+    bodies.push_back({members[live[c]]->body.begin(),
+                      uint32_t(members[live[c]]->body.length())});
+  }
+  int handle = AssembleBodiesAndInstall(
+      bodies, liveSlots, liveIdx, dump,
+      members[live[0]]->mirGen->outerInfo().script());
+  if (handle < 0) return handle;
+  for (uint32_t c = 0; c < n; c++) {
+    tblSlots[live[c]] = liveSlots[c];
+    memberIdx[live[c]] = liveIdx[c];
+  }
+  return handle;
+}
+
+int WJWarpCompile(JSContext* cx, JSScript* script, uint32_t* nargsOut,
