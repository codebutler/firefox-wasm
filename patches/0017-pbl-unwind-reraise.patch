+              "[pbl-reunwind] #%llu pending=%d saved=%s stack=%s\n",
+              (unsigned long long)n, int(cx->isExceptionPending()),
+              gPBLUnwindExc.isUndefined() ? "undefined"
+              : gPBLUnwindExc.isObject() ? "object" : "other",
+              gPBLUnwindExcStack.isObject() ? "object" : "none");
+  }
+  static int sOld = getenv("GECKO_PBL_OLDREUNWIND") ? 1 : 0;
+  if (sOld) {
+    JS::RootedValue rexc(cx, gPBLUnwindExc);
+    cx->setPendingException(rexc, js::ShouldCaptureStack::Maybe);
+    return;
+  }
+  if (cx->isExceptionPending()) return;
+  JS::RootedValue rexc(cx, gPBLUnwindExc);
+  JS::Rooted<js::SavedFrame*> rstack(cx);
+  if (gPBLUnwindExcStack.isObject() &&
+      gPBLUnwindExcStack.toObject().is<js::SavedFrame>()) {
+    rstack = &gPBLUnwindExcStack.toObject().as<js::SavedFrame>();
+  }
