+// Host-stack nesting cap. SpiderMonkey's recursion quota measures the
+// linear-memory (emscripten) C stack, but the engine's wasm frames also take
+// space on the host's own stack, which a page cannot see or measure: wasm
+// cannot catch the host's stack-overflow error, and in an embedding that runs
+// the thread under JSPI the frames sit on a secondary stack that a JS-hosted
+// probe does not share. A recursion that re-enters the interpreter through a
+// native costs one activation per level and a few KB of host stack, and the
+// linear stack it moves is unrelated (about 4 KB a level in one build, tens of
+// bytes in another), so the quota fires long after the host stack is gone and
+// the thread dies with an uncatchable RangeError. Counting activations is the
+// one measure that does not depend on the build or the host's tier. 320 levels
+// is about two thirds of a 984 KB host stack at the cost of an apply recursion
+// in an optimized build (469 levels fill it); system code gets 32 more, so
+// chrome running on top of a capped content stack can still report it.
+// GECKO_HOST_NESTCAP=<n> sets the cap; exactly "0" turns it off, and any
+// other value that is not a positive count keeps the default (with a warning).
+static thread_local int32_t sHostNest = 0;
+
+int32_t js::HostNestEnter() { return ++sHostNest; }
+int32_t js::HostNestExit() { return --sHostNest; }
+int32_t js::HostNestDepth() { return sHostNest; }
+
+static int32_t HostNestCap() {
+  static const int32_t sCap = [] {
+    const int32_t kDefault = 320;
+    const char* v = getenv("GECKO_HOST_NESTCAP");
+    if (!v || !*v) {
+      return kDefault;
+    }
+    if (strcmp(v, "0") == 0) {
+      return int32_t(0);
+    }
+    char* end = nullptr;
+    long n = strtol(v, &end, 10);
+    if (*end || n <= 0 || n > 1000000) {
+      fprintf(stderr, "[host-nest] ignoring GECKO_HOST_NESTCAP=%s (cap %d)\n",
+              v, int(kDefault));
+      return kDefault;
+    }
+    return int32_t(n);
+  }();
+  return sCap;
+}
+
+bool js::HostNestOverLimit(JSContext* cx) {
+  int32_t nest = sHostNest;
+  // GECKO_WJ_SUSDBG: report this thread's deepest nesting, in steps of 32
+  // (ptr= is the pthread, as the embedder's thread logs name it), so
+  // a page's real depth can be compared against the cap (with the cap off
+  // too, which measures it unperturbed).
+  static const bool sDbg = getenv("GECKO_WJ_SUSDBG") != nullptr;
+  if (sDbg) {
+    thread_local int32_t sHigh = 0;
+    if (nest >= sHigh + 32) {
+      sHigh = nest - nest % 32;
+      fprintf(stderr, "[host-nest] high=%d ptr=%lu\n", int(nest),
+              (unsigned long)pthread_self());
+    }
+  }
+  int32_t cap = HostNestCap();
+  if (!cap || nest <= cap) {
+    return false;
+  }
+  bool system = cx->realm() && cx->realm()->isSystem();
+  if (system && nest <= cap + 32) {
+    return false;
+  }
+  if (sDbg) {
+    static std::atomic<uint32_t> sReports{0};
+    uint32_t n = ++sReports;
+    if (n <= 20 || n % 1000 == 0) {
+      fprintf(stderr, "[host-nest] cap #%u nest=%d cap=%d system=%d ptr=%lu\n",
+              unsigned(n), int(nest), int(cap), int(system),
+              (unsigned long)pthread_self());
+    }
+  }
+  return true;
+}
+#endif
